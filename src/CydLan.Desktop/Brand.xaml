<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The open C is a conversation bubble; the separate dot is its LAN peer. -->
  <DrawingGroup x:Key="BrandSymbol">
    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z"/>
    <GeometryDrawing Geometry="M44,17 C40,13 35,11 30,11 C18,11 10,20 10,32 C10,39 13,45 18,49 L15,57 L29,53 C35,53 40,51 44,47">
      <GeometryDrawing.Pen><Pen Brush="#85B1BF" Thickness="7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
    </GeometryDrawing>
    <GeometryDrawing Geometry="M32,32 L44,32">
      <GeometryDrawing.Pen><Pen Brush="#85B1BF" Thickness="5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
    </GeometryDrawing>
    <GeometryDrawing Brush="#EDF4F6"><GeometryDrawing.Geometry><EllipseGeometry Center="50,32" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
  </DrawingGroup>
  <!-- Same mark tuned for light surfaces: deeper teal stroke and an ink dot so it stays visible on white. -->
  <DrawingGroup x:Key="BrandSymbolLight">
    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z"/>
    <GeometryDrawing Geometry="M44,17 C40,13 35,11 30,11 C18,11 10,20 10,32 C10,39 13,45 18,49 L15,57 L29,53 C35,53 40,51 44,47">
      <GeometryDrawing.Pen><Pen Brush="#4E8C9E" Thickness="7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
    </GeometryDrawing>
    <GeometryDrawing Geometry="M32,32 L44,32">
      <GeometryDrawing.Pen><Pen Brush="#4E8C9E" Thickness="5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
    </GeometryDrawing>
    <GeometryDrawing Brush="#1F2B30"><GeometryDrawing.Geometry><EllipseGeometry Center="50,32" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
  </DrawingGroup>
  <DrawingImage x:Key="BrandMarkOnDark" Drawing="{StaticResource BrandSymbol}"/>
  <DrawingImage x:Key="BrandMarkOnLight" Drawing="{StaticResource BrandSymbolLight}"/>
  <DrawingImage x:Key="BrandAppIcon">
    <DrawingImage.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#202729" Geometry="M15,0 H49 Q64,0 64,15 V49 Q64,64 49,64 H15 Q0,64 0,49 V15 Q0,0 15,0 Z"/>
      <StaticResource ResourceKey="BrandSymbol"/>
    </DrawingGroup></DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
