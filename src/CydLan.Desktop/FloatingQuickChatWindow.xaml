<Window x:Class="CydLan.Desktop.FloatingQuickChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CydLan.Desktop"
        xmlns:core="clr-namespace:CydLan.Core;assembly=CydLan.Core"
        Style="{StaticResource {x:Type Window}}" Title="CydLan Quick Chat"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" Width="320" Height="412">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Bool"/>
    <local:ImagePathConverter x:Key="ImageFile"/>
    <local:AvatarPathConverter x:Key="AvatarFile"/>
    <local:LookMessageConverter x:Key="LookMessage"/>
    <Style x:Key="PeerChipStyle" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chip" Padding="7,4" CornerRadius="{DynamicResource ControlCorner}"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RowSelected}"/>
                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border CornerRadius="{DynamicResource OverlayCorner}" Background="{DynamicResource Canvas}"
          BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Background="{DynamicResource Sidebar}" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False"/>
      <Border Background="{DynamicResource ChromeColorFinishBrush}" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False"/>
      <Border Background="{DynamicResource ChatSurfaceBackground}" Grid.Row="2" Grid.RowSpan="2" IsHitTestVisible="False"/>
      <Grid Grid.Row="2" Grid.RowSpan="{Binding ChatBackdropRowSpan}" ClipToBounds="True" IsHitTestVisible="False">
        <Grid OpacityMask="{Binding ChatBackgroundHorizontalMask}" IsHitTestVisible="False">
          <Grid OpacityMask="{Binding ChatBackgroundVerticalMask}" IsHitTestVisible="False">
            <local:BackgroundImageViewport Fit="{Binding ChatBackgroundFit}"
                                           Anchor="{Binding ChatBackgroundAnchor}"
                                           ImageScale="{Binding ChatBackgroundScale}"
                                           IsHitTestVisible="False">
              <Image local:AnimatedGifBehavior.FallbackSource="{Binding ChatBackground}"
                     local:AnimatedGifBehavior.Sequence="{Binding ChatBackgroundGif}"
                     Opacity="{Binding ChatBackgroundOpacity}" Effect="{Binding ChatBackgroundBlurEffect}"
                     Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            </local:BackgroundImageViewport>
            <Border Background="{DynamicResource Canvas}" Opacity="{Binding ChatBackgroundDim}" IsHitTestVisible="False">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ChatBackground}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>
          </Grid>
        </Grid>
      </Grid>
      <Border Background="{DynamicResource ChatColorFinishBrush}" Grid.Row="2" Grid.RowSpan="2" IsHitTestVisible="False"/>

      <!-- Compact Header -->
      <Grid Grid.Row="0" Margin="12,8,8,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Ellipse Width="7" Height="7" Fill="{DynamicResource Online}" VerticalAlignment="Center" Margin="0,0,7,0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding ChatTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="136"/>
          <TextBlock FontSize="11" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="7,0,0,0">
            <Run Text="{Binding OnlineCount, Mode=OneWay}"/><Run Text=" online"/>
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="RoamButton" Width="26" Height="26" Padding="0" Click="Roam_Click" ToolTip="Roam" AutomationProperties.Name="Toggle roam">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Icon}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding FloatingLanRoam}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NavSelected}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <local:Glyph Data="{DynamicResource IconRoam}" Size="14"/>
          </Button>
          <Button Style="{StaticResource Icon}" Width="26" Height="26" Padding="0" Click="OpenFull_Click" ToolTip="Open CydLan" AutomationProperties.Name="Open CydLan">
            <local:Glyph Data="{DynamicResource IconOpenWindow}" Size="14"/>
          </Button>
          <Button Style="{StaticResource Icon}" Width="26" Height="26" Padding="0" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close quick chat">
            <local:Glyph Data="{DynamicResource IconClose}" Size="13"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Horizontal Peer Switcher Strip (active chatters only) -->
      <Border x:Name="QuickPeersBorder" Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,0,10,8"
              Visibility="{Binding HasQuickChatPeers, Converter={StaticResource Bool}}">
        <ListBox x:Name="QuickPeersList" ItemsSource="{Binding QuickChatPeers}" SelectedItem="{Binding SelectedPeer}"
                 ItemContainerStyle="{StaticResource PeerChipStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectionChanged="Peer_SelectionChanged" PreviewMouseWheel="QuickPeers_PreviewMouseWheel" AutomationProperties.Name="Active chats">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type core:Peer}">
              <StackPanel Orientation="Horizontal">
                <Grid Width="18" Height="18" Margin="0,0,6,0">
                  <Border CornerRadius="9" Background="{DynamicResource Avatar}">
                    <TextBlock Text="{Binding Initials}" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Image Source="{Binding AvatarPath, Converter={StaticResource AvatarFile}}" Stretch="UniformToFill" local:Rounded.Radius="9"/>
                  <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"
                           Stroke="{DynamicResource Surface}" StrokeThickness="1">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource Faint}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Online}" Value="True"><Setter Property="Fill" Value="{DynamicResource Online}"/></DataTrigger>
                          <DataTrigger Binding="{Binding Presence}" Value="Away"><Setter Property="Fill" Value="{DynamicResource Away}"/></DataTrigger>
                          <DataTrigger Binding="{Binding Presence}" Value="Busy"><Setter Property="Fill" Value="{DynamicResource Away}"/></DataTrigger>
                          <DataTrigger Binding="{Binding Presence}" Value="Do not disturb"><Setter Property="Fill" Value="{DynamicResource Danger}"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource Ink}" MaxWidth="82" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border Margin="5,0,0,0" Padding="4,0" Height="15" MinWidth="15" CornerRadius="7.5" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers><DataTrigger Binding="{Binding Unread}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Unread}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Compact Message Feed -->
      <ScrollViewer x:Name="QuickScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10,8,10,4">
        <ItemsControl x:Name="QuickMessagesList" ItemsSource="{Binding Messages}" HorizontalContentAlignment="Stretch">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,8">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Outgoing}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <Border MaxWidth="226" Padding="9,6">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource IncomingBubbleBackground}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource IncomingBubbleBorder}"/>
                      <Setter Property="BorderThickness" Value="{DynamicResource IncomingBubbleBorderThickness}"/>
                      <Setter Property="CornerRadius" Value="{DynamicResource IncomingBubbleCorner}"/>
                      <Setter Property="TextElement.Foreground" Value="{DynamicResource IncomingBubbleForeground}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Outgoing}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource OutgoingBubbleBackground}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource OutgoingBubbleBorder}"/>
                          <Setter Property="BorderThickness" Value="{DynamicResource OutgoingBubbleBorderThickness}"/>
                          <Setter Property="CornerRadius" Value="{DynamicResource OutgoingBubbleCorner}"/>
                          <Setter Property="TextElement.Foreground" Value="{DynamicResource OutgoingBubbleForeground}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasFile, Converter={StaticResource Bool}}">
                      <local:Glyph Data="{DynamicResource IconFile}" Size="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="182"/>
                    </StackPanel>
                    <Image Source="{Binding ImagePath, Converter={StaticResource ImageFile}}" Stretch="Uniform" MaxHeight="96" MaxWidth="190"
                           local:Rounded.Radius="6" Margin="0,0,0,4" Visibility="{Binding HasImage, Converter={StaticResource Bool}}"/>
                    <TextBlock Text="{Binding Text, Converter={StaticResource LookMessage}, ConverterParameter=caption}" FontSize="12.5" FontFamily="{DynamicResource MessageFontFamily}" TextWrapping="Wrap"
                               Visibility="{Binding Text, Converter={StaticResource LookMessage}, ConverterParameter=caption_plain}"/>
                    <TextBlock local:SmileyText.Text="{Binding Text, Converter={StaticResource LookMessage}, ConverterParameter=caption}" FontSize="12.5" FontFamily="{DynamicResource MessageFontFamily}" TextWrapping="Wrap"
                               Visibility="{Binding Text, Converter={StaticResource LookMessage}, ConverterParameter=caption_smiley}"/>
                    <Grid Visibility="{Binding Text, Converter={StaticResource LookMessage}, ConverterParameter=card}" Margin="0,2,0,0">
                      <Border DataContext="{Binding Text, Converter={StaticResource LookMessage}}"
                              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                              CornerRadius="{DynamicResource ControlCorner}" Padding="6,5" TextElement.Foreground="{DynamicResource Ink}">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Border Width="28" Height="24" CornerRadius="5" Background="{Binding CanvasBrush}" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                              <Border Width="9" HorizontalAlignment="Left" Background="{Binding SidebarBrush}"/>
                              <Image Source="{Binding BackgroundPreview}" Stretch="UniformToFill" Opacity="0.82" Visibility="{Binding HasBackground, Converter={StaticResource Bool}}"/>
                              <Ellipse Width="6" Height="6" Fill="{Binding AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"/>
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,6,0">
                            <TextBlock Text="{Binding ThemeName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" MaxWidth="98"/>
                            <TextBlock Text="{Binding FontLabel}" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="98" Visibility="{Binding HasFontLabel, Converter={StaticResource Bool}}"/>
                          </StackPanel>
                          <Button Grid.Column="2" Content="Apply" Style="{StaticResource Primary}" Padding="8,3" FontSize="11" VerticalAlignment="Center"
                                  Click="ApplyLook_Click" AutomationProperties.Name="Apply theme"/>
                        </Grid>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="{DynamicResource Faint}" Margin="3,2,3,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Left"/>
                      <Style.Triggers><DataTrigger Binding="{Binding Outgoing}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Compact Message Composer -->
      <Border Grid.Row="3" Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="{DynamicResource ControlCorner}" Margin="10,4,10,10" Padding="6,4">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid VerticalAlignment="Center">
            <TextBox x:Name="QuickComposer" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent" BorderThickness="0" Padding="4,5" FontSize="12.5" FontFamily="{DynamicResource MessageFontFamily}"
                     AcceptsReturn="True" TextWrapping="Wrap" MaxLength="14000000" MinHeight="28" MaxHeight="74"
                     VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanCompose}"
                     PreviewKeyDown="QuickComposer_KeyDown" GotKeyboardFocus="QuickComposer_GotFocus"
                     AutomationProperties.Name="Quick message"/>
            <TextBlock Text="Message…" FontSize="12.5" Foreground="{DynamicResource Faint}" Margin="6,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><DataTrigger Binding="{Binding Draft}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <Button x:Name="QuickSendButton" Grid.Column="1" Style="{StaticResource SendIcon}" Width="30" Height="30"
                  VerticalAlignment="Bottom" IsEnabled="{Binding CanSend}" Click="Send_Click"
                  ToolTip="Send" AutomationProperties.Name="Send message">
            <local:Glyph Data="{DynamicResource IconSend}" Size="15" StrokeThickness="2.2"/>
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
