<Window x:Class="CydLan.Desktop.TrayMenuWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CydLan tray menu" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" Width="276" SizeToContent="Height" WindowStartupLocation="Manual">
  <Window.Resources>
    <Style x:Key="TrayAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F0EBFC"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="#F0EBFC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E7E2F1" BorderThickness="1" Padding="10">
    <StackPanel>
      <Grid Margin="10,8,10,14"><Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" Background="#967BE5" CornerRadius="10" HorizontalAlignment="Left"><TextBlock Text="c" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-5,0,0"/></Border><StackPanel Grid.Column="1"><TextBlock Text="cydlan" FontSize="15" FontWeight="Bold"/><TextBlock Text="Offline design mode" FontSize="10" Foreground="#9990AD" Margin="0,3,0,0"/></StackPanel></Grid>
      <Border Background="#ECE9F2" Height="1" Margin="4,0,4,6"/>
      <Button x:Name="OpenAction" Style="{StaticResource TrayAction}" Click="Open_Click"><Grid><TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" Foreground="#9276D5" VerticalAlignment="Center"/><TextBlock Text="Open CydLan" Margin="30,0,0,0" FontSize="12" FontWeight="SemiBold"/></Grid></Button>
      <Button Style="{StaticResource TrayAction}" Click="Transfers_Click"><Grid><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Foreground="#9B91B3" VerticalAlignment="Center"/><TextBlock Text="File transfers" Margin="30,0,0,0" FontSize="12"/></Grid></Button>
      <Button Style="{StaticResource TrayAction}" Click="Settings_Click"><Grid><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#9B91B3" VerticalAlignment="Center"/><TextBlock Text="Preferences" Margin="30,0,0,0" FontSize="12"/></Grid></Button>
      <Border Background="#ECE9F2" Height="1" Margin="4,7,4,7"/>
      <Button Style="{StaticResource TrayAction}" Click="Quit_Click"><Grid><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="#AB8396" VerticalAlignment="Center"/><TextBlock Text="Quit CydLan" Margin="30,0,0,0" FontSize="12" Foreground="#936B7F"/></Grid></Button>
    </StackPanel>
  </Border>
</Window>
