<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/brand/cydlan.ico</ApplicationIcon>
    <AssemblyName>CydLan</AssemblyName>
    <Version>0.1.0</Version>
    <Product>CydLan</Product>
    <!-- WPF owns the window DPI policy; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../CydLan.Core/CydLan.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="../../assets/brand/cydlan.ico" Link="Assets/cydlan.ico" /></ItemGroup>
</Project>
