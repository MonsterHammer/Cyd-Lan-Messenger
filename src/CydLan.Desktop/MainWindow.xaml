                      </Grid>
                    </Border><Button Style="{StaticResource HeaderIcon}" ToolTip="Files" Click="ConversationFiles_Click" IsEnabled="{Binding HasPeer}" AutomationProperties.Name="Files in this conversation"><local:Glyph Data="{DynamicResource IconFile}" Size="17"/></Button><Button Style="{StaticResource HeaderIcon}" ToolTip="Contact details" Click="Details_Click" IsEnabled="{Binding HasDetails}" AutomationProperties.Name="Contact details"><local:Glyph Data="{DynamicResource IconInfo}" Size="18"/></Button>
                    <Button x:Name="MoreButton" Style="{StaticResource HeaderIcon}" ToolTip="More" Click="More_Click" AutomationProperties.Name="More options"><local:Glyph Data="{DynamicResource IconMore}" Size="18" StrokeThickness="2.6"/>
                      <Button.ContextMenu><ContextMenu Placement="Bottom">
                        <MenuItem Header="Delete chat" Click="DeleteChat_Click" IsEnabled="{Binding HasDetails}"/>
                        <MenuItem Header="Delete all chats" Click="DeleteAllChats_Click"/>
                      </ContextMenu></Button.ContextMenu>
                    </Button></StackPanel>
                </Grid>
              </Grid>
