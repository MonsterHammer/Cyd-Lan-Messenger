<Window x:Class="CydLan.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="CydLan" Width="1320" Height="860" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#FFFFFF">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Bool"/>
    <DataTemplate x:Key="MessageTemplate">
      <Grid Margin="0,0,0,20">
        <Grid.Style><Style TargetType="Grid"><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding Outgoing}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <StackPanel MaxWidth="470">
          <Border Padding="17,12" CornerRadius="4,16,16,16">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F0F2F7"/><Style.Triggers><DataTrigger Binding="{Binding Outgoing}" Value="True"><Setter Property="Background" Value="#EDE8FC"/><Setter Property="CornerRadius" Value="16,4,16,16"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel><TextBlock Text="ANNOUNCEMENT" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,6" Visibility="{Binding Broadcast, Converter={StaticResource Bool}}"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="23" FontSize="14"/></StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="4,7,4,0"><TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="#9296A6"/><TextBlock Text="  ·  " FontSize="10" Foreground="#9296A6"/><TextBlock Text="{Binding Delivery}" FontSize="10" Foreground="#9296A6"/></StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="286"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <!-- Compact app rail -->
    <Border Background="#232633"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
      <Border Width="40" Height="40" CornerRadius="13" Background="#9A83EC" VerticalAlignment="Center"><TextBlock Text="c" Foreground="White" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-6,0,0"/></Border>
      <StackPanel Grid.Row="1" Margin="0,12,0,0">
        <Button x:Name="ChatNav" Content="&#xE8BD;" Style="{StaticResource Icon}" Foreground="#D9CFFC" Background="#3E365B" Width="46" Height="46" Margin="0,0,0,14" ToolTip="Conversations" Click="Chat_Click"/>
        <Button Content="&#xE77B;" Style="{StaticResource Icon}" Foreground="#9A9FB4" Width="46" Height="46" Margin="0,0,0,14" ToolTip="Find people" Click="People_Click"/>
        <Button Content="&#xE898;" Style="{StaticResource Icon}" Foreground="#9A9FB4" Width="46" Height="46" Margin="0,0,0,14" ToolTip="File transfers" Click="Transfers_Click"/>
        <Button Content="&#xE789;" Style="{StaticResource Icon}" Foreground="#9A9FB4" Width="46" Height="46" ToolTip="Broadcast to network" Click="Broadcast_Click"/>
      </StackPanel>
      <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,22"><Button Content="&#xE713;" Style="{StaticResource Icon}" Foreground="#9A9FB4" Margin="0,0,0,14" ToolTip="Settings" Click="Settings_Click"/><Button Padding="0" Width="38" Height="38" Background="#DAD2F2" Click="Settings_Click" ToolTip="Your profile"><TextBlock Text="{Binding ProfileInitial}" Foreground="#5A457E" FontWeight="SemiBold" FontSize="16"/></Button></StackPanel>
    </Grid></Border>
    <!-- People and conversations -->
    <Border Grid.Column="1" Background="#F9FAFD" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="103"/><RowDefinition Height="62"/><RowDefinition Height="49"/><RowDefinition Height="*"/><RowDefinition Height="112"/></Grid.RowDefinitions>
      <StackPanel Margin="26,24,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="cydlan" FontSize="27" FontWeight="Bold"/><Border Background="#EDE8FA" CornerRadius="4" Padding="5,2" Margin="9,10,0,4"><TextBlock Text="LOCAL" FontSize="8" FontWeight="Bold" Foreground="#8067BF"/></Border></StackPanel><TextBlock Text="A better way to stay connected." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
      <Border Grid.Row="1" Margin="20,4,20,16" Background="#EFF1F6" CornerRadius="8"><Grid><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#999EAF" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox x:Name="PeopleSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="28,0,0,0" Background="Transparent" BorderThickness="0" Padding="7,10" FontSize="12" ToolTip="Search people, IP addresses, or message history"/><TextBlock Text="Search people or messages" Margin="36,0,0,0" FontSize="11" Foreground="#969BAD" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
      <Grid Grid.Row="2" Margin="25,0,19,10"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="MESSAGES" FontSize="10" FontWeight="SemiBold" Foreground="#858B9C"/><Border Background="#E9ECF4" CornerRadius="5" Padding="6,2" Margin="8,-2,0,-2"><TextBlock Text="{Binding OnlineCount}" FontSize="10" Foreground="#6D7388"/></Border></StackPanel><Button Content="&#xE72C;" Style="{StaticResource Icon}" HorizontalAlignment="Right" Width="28" Height="28" FontSize="13" ToolTip="Refresh people on LAN" Click="Refresh_Click"/></Grid>
      <ListBox Grid.Row="3" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPeer}" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate><DataTemplate><Grid Margin="14,16"><Grid.ColumnDefinitions><ColumnDefinition Width="49"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
          <Grid Width="37" Height="37" HorizontalAlignment="Left"><Border Background="#E3E0F2" CornerRadius="12"><TextBlock Text="{Binding Initials}" Foreground="#77629F" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Ellipse Width="10" Height="10" Stroke="#F9FAFD" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#BCBFCC"/><Style.Triggers><DataTrigger Binding="{Binding Online}" Value="True"><Setter Property="Fill" Value="#65BEA5"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="busy"><Setter Property="Fill" Value="#E7AE70"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="away"><Setter Property="Fill" Value="#E7AE70"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse></Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Preview}" Foreground="#9296A7" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel>
          <Border Grid.Column="2" Background="#8D74DD" CornerRadius="8" VerticalAlignment="Center" Height="18"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Unread}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Unread}" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Row="4" Background="#F0F1F8" CornerRadius="11" Margin="20,12,20,21" Padding="13,12"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#64B79D" Margin="0,0,7,0"/><TextBlock Text="YOUR LOCAL NETWORK" FontSize="9" Foreground="#7D8296" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{Binding NetworkStatus}" Foreground="#5E657B" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    </Grid></Border>
    <!-- Main workspace -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="83"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Background="White" MouseLeftButtonDown="TitleBar_MouseDown"><TextBlock Text="WORKSPACE  /  OFFLINE DESIGN" Foreground="#B1B4C1" FontSize="9" Margin="30,0,0,0" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="&#xE921;" Style="{StaticResource Icon}" Width="42" FontSize="10" ToolTip="Minimize" Click="Minimize_Click"/><Button Content="&#xE922;" Style="{StaticResource Icon}" Width="42" FontSize="10" ToolTip="Maximize / restore" Click="Maximize_Click"/><Button Content="&#xE8BB;" Style="{StaticResource Icon}" Width="42" FontSize="10" ToolTip="Close to tray" Click="Close_Click"/></StackPanel></Grid>
      <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><Grid Margin="30,4,24,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ChatTitle}" FontWeight="SemiBold" FontSize="19"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse Width="6" Height="6" Fill="#7ABDA8" Margin="0,0,7,0"/><TextBlock Text="{Binding ChatSubtitle}" FontSize="11" Foreground="#9096A6"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="&#xE721;" Style="{StaticResource Icon}" ToolTip="Search this conversation" Click="SearchMessages_Click"/><Button Content="&#xE946;" Style="{StaticResource Icon}" ToolTip="Connection details" Click="Details_Click"/></StackPanel></Grid></Border>
      <Grid Grid.Row="2" Visibility="{Binding ChatOpen, Converter={StaticResource Bool}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="0"/></Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBox x:Name="MessageSearchBox" Text="{Binding MessageSearch, UpdateSourceTrigger=PropertyChanged}" Margin="30,15,30,5" Visibility="Collapsed" ToolTip="Search messages in this conversation"/>
          <Grid Grid.Row="1"><ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto" Padding="32,22,32,12"><StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26" Visibility="{Binding HasPeer, Converter={StaticResource Bool}}"><Border Height="1" Width="60" Background="#EBEDF3" VerticalAlignment="Center"/><TextBlock Text="CONVERSATION" Foreground="#B0B4C1" FontSize="9" Margin="15,0"/><Border Height="1" Width="60" Background="#EBEDF3" VerticalAlignment="Center"/></StackPanel>
            <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}"/>
          </StackPanel></ScrollViewer>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Visibility="{Binding NoPeer, Converter={StaticResource Bool}}" Margin="30"><Border Background="#F0ECFC" CornerRadius="24" Width="86" Height="86"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#9880DC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Good conversations start nearby." FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,26,0,13" TextWrapping="Wrap"/><TextBlock Text="People on your LAN appear here automatically. Choose someone to start a private conversation." TextAlignment="Center" Foreground="#9297A7" FontSize="13" LineHeight="23" TextWrapping="Wrap"/><Button Content="Find people on LAN" Style="{StaticResource Primary}" Margin="40,27,40,0" Click="Refresh_Click"/><TextBlock Text="No account. No cloud. Just connected." FontSize="11" Foreground="#ADB1BF" HorizontalAlignment="Center" Margin="0,23,0,0"/></StackPanel>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Visibility="{Binding Broadcasting, Converter={StaticResource Bool}}" Margin="30"><TextBlock Text="&#xE789;" FontFamily="Segoe MDL2 Assets" Foreground="#A28BDF" FontSize="40" HorizontalAlignment="Center"/><TextBlock Text="Let everyone know." FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,14"/><TextBlock Text="Your announcement goes directly to each connected person on this network." TextWrapping="Wrap" TextAlignment="Center" LineHeight="23" Foreground="{StaticResource Muted}"/></StackPanel>
          </Grid>
          <TextBlock Grid.Row="2" Text="{Binding SelectedPeer.Typing}" Foreground="{StaticResource Muted}" FontSize="11" Margin="36,0,36,8"/>
          <Border Grid.Row="3" Background="White" Margin="28,0,28,23" BorderBrush="#E6E8F0" BorderThickness="1" CornerRadius="13" Padding="6"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="42"/></Grid.RowDefinitions>
            <TextBox x:Name="Composer" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="12,12" MinHeight="58" MaxHeight="160" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="32000" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanCompose}" PreviewKeyDown="Composer_KeyDown" TextChanged="Composer_TextChanged" ToolTip="Write a message. Enter sends; Shift+Enter starts a new line."/>
            <TextBlock Text="Write a message…" Foreground="#AAAFBE" Margin="12,14,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Draft}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Grid Grid.Row="1"><StackPanel Orientation="Horizontal"><Button Content="&#xE723;" Style="{StaticResource Icon}" ToolTip="Send a file" Click="Attach_Click" IsEnabled="{Binding HasPeer}"/><Button Content="&#xE899;" Style="{StaticResource Icon}" ToolTip="Insert a smile" Click="Emoji_Click"/><TextBlock Text="Enter to send · Shift + Enter for a new line" FontSize="9" Foreground="#B1B5C3" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel><Button Content="Send  ↗" Style="{StaticResource Primary}" HorizontalAlignment="Right" Padding="18,8" Margin="0,1,2,1" FontSize="12" IsEnabled="{Binding CanCompose}" Click="Send_Click"/></Grid>
          </Grid></Border>
        </Grid>
        <Border Grid.Column="1" Background="#FBFBFE" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"><StackPanel Margin="22,30"><TextBlock Text="CONNECTION DETAILS" FontSize="10" Foreground="#A0A5B5" FontWeight="SemiBold"/><Border Width="64" Height="64" Background="#EAE5F7" CornerRadius="22" Margin="0,30,0,16"><TextBlock Text="{Binding SelectedPeer.Initials}" FontSize="21" Foreground="#8971B8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding SelectedPeer.Name}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding SelectedPeer.Presence}" Foreground="#89AD9C" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,24"/><Border Background="#EEEBF8" Padding="11,9" CornerRadius="7"><TextBlock Text="{Binding ConnectionLabel}" FontSize="10" Foreground="#8C76BC" TextAlignment="Center"/></Border><TextBlock Text="DEVICE ADDRESS" FontSize="9" Foreground="#A3A8B7" Margin="0,29,0,8"/><TextBlock Text="{Binding SelectedPeer.Address}" FontSize="12"/><TextBlock Text="CLIENT" FontSize="9" Foreground="#A3A8B7" Margin="0,23,0,8"/><TextBlock Text="{Binding SelectedPeer.Version}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="PRIVACY" FontSize="9" Foreground="#A3A8B7" Margin="0,23,0,8"/><TextBlock Text="{Binding ConnectionPrivacy}" TextWrapping="Wrap" FontSize="11" Foreground="#9297A8" LineHeight="20"/><Button Content="Send a file  ↗" Background="#EFEAF9" Foreground="#8870B8" FontSize="11" Margin="0,29,0,0" Click="Attach_Click" IsEnabled="{Binding HasPeer}"/></StackPanel></Border>
      </Grid>
      <!-- Transfer workspace -->
      <Grid Grid.Row="2" Background="#FCFCFE" Visibility="{Binding TransfersOpen, Converter={StaticResource Bool}}" Margin="0"><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="32,24,0,0"><TextBlock Text="File transfers" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Share directly. Accept incoming files before downloading." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel><ScrollViewer Grid.Row="1" Padding="30,0,30,25"><ItemsControl ItemsSource="{Binding Transfers}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,13" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="#9D87D4" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,6,0,9"><TextBlock Text="{Binding DirectionLabel}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text=" · " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding SizeLabel}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text=" · " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding State}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel><ProgressBar Value="{Binding Progress}" Height="3" BorderThickness="0" Foreground="#A38BD9" Background="#F1EDF8"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="Waiting for approval"/><Condition Binding="{Binding Outgoing}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="Decline" FontSize="11" Click="DeclineFile_Click"/><Button Content="Save file" Style="{StaticResource Primary}" FontSize="11" Click="AcceptFile_Click"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Grid.Row="1" Text="No transfers yet. Open a conversation and attach a file." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Transfers.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <StackPanel Grid.Row="3"><Border Background="#F5F1FF" Padding="17,10" Margin="20,0,20,10" CornerRadius="8"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Toast}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Toast}" Foreground="#8368B4" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="×" Padding="5,0" Click="DismissToast_Click"/></Grid></Border><Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="30,10"><Grid><TextBlock Text="{Binding DeviceLabel}" FontSize="9" Foreground="#B2B6C3"/><TextBlock Text="DESIGN WORKSPACE  ·  SAMPLE DATA" FontSize="8" Foreground="#B2B6C3" HorizontalAlignment="Right"/></Grid></Border></StackPanel>
    </Grid>
  </Grid>
</Window>
