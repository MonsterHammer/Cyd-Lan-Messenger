                            <ItemsControl.ItemTemplate><DataTemplate>
                              <Button Style="{StaticResource Icon}" Width="30" Height="30" Padding="0" Click="Smiley_Click" Tag="{Binding Code}" ToolTip="{Binding Code}" AutomationProperties.Name="{Binding Code}"><Image Source="{Binding Image}" Width="19" Height="19"/></Button>
