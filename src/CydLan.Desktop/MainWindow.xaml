                          </Grid>
                          <ProgressBar Style="{StaticResource TransferProgress}" AutomationProperties.Name="{Binding ActiveLabel}"/>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="Waiting for approval"/><Condition Binding="{Binding Outgoing}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="Decline" Style="{StaticResource Secondary}" Margin="0,0,6,0" Click="DeclineFile_Click"/><Button Content="Accept" Style="{StaticResource Primary}" Click="AcceptFile_Click"/></StackPanel>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="Waiting for approval"/><Condition Binding="{Binding Outgoing}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="Cancel offer" Style="{StaticResource Secondary}" Click="CancelOffer_Click"/></StackPanel>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="{Binding IsActive, Converter={StaticResource Bool}}"><Button Content="Cancel" Style="{StaticResource Secondary}" Background="{DynamicResource Hover}" Click="CancelOffer_Click" AutomationProperties.Name="Cancel transfer"/></StackPanel>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Received"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Sent · receipt unavailable"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Style="{StaticResource Icon}" Width="28" Height="28" ToolTip="Play" Click="PlayFile_Click" Visibility="{Binding Name, Converter={StaticResource MediaFile}}" AutomationProperties.Name="Play file"><local:Glyph Data="{DynamicResource IconPlay}" Size="13"/></Button><Button Style="{StaticResource Icon}" Width="28" Height="28" ToolTip="Show in folder" Click="ShowFile_Click" AutomationProperties.Name="Show in folder"><local:Glyph Data="{DynamicResource IconFolder}" Size="15"/></Button><Button Style="{StaticResource Icon}" Width="28" Height="28" ToolTip="Open" Click="OpenFile_Click" AutomationProperties.Name="Open file"><local:Glyph Data="{DynamicResource IconDownload}" Size="15"/></Button></StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </ScrollViewer>
                  <TextBlock Grid.Row="2" Text="No files" FontSize="13" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="{Binding NoConversationFiles, Converter={StaticResource Bool}}"/>
                  <StackPanel Grid.Row="3" Margin="14,4,14,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <Button x:Name="OlderFilesButton" Content="Older files" Style="{StaticResource Secondary}" Margin="0,0,4,6"
                              Visibility="{Binding HasOlderFiles, Converter={StaticResource Bool}}" Click="PageFiles_Click"/>
                      <Button Content="Newer files" Style="{StaticResource Secondary}" Margin="4,0,0,6"
                              Visibility="{Binding HasNewerFiles, Converter={StaticResource Bool}}" Click="PageFiles_Click"/>
                    </StackPanel>
                    <Button Content="Open received folder" Style="{StaticResource Secondary}" Click="OpenReceivedFolder_Click"/>
                  </StackPanel>
                  </Grid>
                </Grid>
              </Border>
              <Border x:Name="GroupPanel" Width="242" Visibility="Collapsed" HorizontalAlignment="Right" Background="{DynamicResource SidebarPanelBackground}" TextElement.Foreground="{DynamicResource SidebarInk}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" ClipToBounds="True">
                <Grid>
                  <Border Background="{DynamicResource ChromeColorFinishBrush}" IsHitTestVisible="False"/>
