                      <Border Background="{DynamicResource Canvas}" Opacity="{Binding ChatBackgroundDim}" IsHitTestVisible="False">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ChatBackground}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                    </Grid>
                  </Grid>
                  <local:SakuraPetals x:Name="ConversationPetals" Intensity="{Binding PetalIntensity}"
