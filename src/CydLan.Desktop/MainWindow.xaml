                          <Button Content="Snooze" Style="{StaticResource Secondary}" Padding="10,5" MinWidth="76" Margin="0,6,0,0" Tag="{Binding Id}" CommandParameter="10" Click="ReminderSnooze_Click"
                                  Visibility="{Binding CanAct, Converter={StaticResource Bool}}" AutomationProperties.Name="Snooze reminder"/>
                          <Button Content="Undo" Style="{StaticResource Secondary}" Padding="10,5" Tag="{Binding Id}" Click="ReminderUndo_Click"
                                  Visibility="{Binding IsDone, Converter={StaticResource Bool}}" AutomationProperties.Name="Undo reminder done"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsDue}" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        <Setter TargetName="StateChip" Property="Background" Value="{DynamicResource Accent}"/>
                        <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource AccentInk}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Missed">
                        <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Danger}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                        <Setter TargetName="IconGlyph" Property="Foreground" Value="{DynamicResource Danger}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsDone}" Value="True">
                        <Setter TargetName="Card" Property="Opacity" Value=".72"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Enabled}" Value="False">
                        <Setter TargetName="Card" Property="Opacity" Value=".55"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="No reminders" Foreground="{DynamicResource ContentMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoRemindersShown, Converter={StaticResource Bool}}"/>

