                      <Grid Width="40" Height="40">
                        <Border CornerRadius="{DynamicResource HeaderAvatarCorner}" BorderThickness="2" Margin="-2" IsHitTestVisible="False">
                          <Border.Style><Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Online}"/>
                            <Style.Triggers>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding SelectedPeer.Online}" Value="True"/>
                                  <Condition Binding="{Binding OnlineRingEnabled}" Value="True"/>
                                </MultiDataTrigger.Conditions>
