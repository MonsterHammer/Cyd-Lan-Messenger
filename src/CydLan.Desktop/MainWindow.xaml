<Window x:Class="CydLan.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CydLan.Desktop"
        xmlns:core="clr-namespace:CydLan.Core;assembly=CydLan.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource {x:Type Window}}" Title="CydLan" Width="800" Height="560" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowDrop="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Bool"/>
    <local:ImagePathConverter x:Key="ImageFile"/>
    <local:AvatarPathConverter x:Key="AvatarFile"/>
    <local:SmileyVisibilityConverter x:Key="SmileyVisibility"/>
    <local:LookMessageConverter x:Key="LookMessage"/>
    <local:MediaFileVisibilityConverter x:Key="MediaFile"/>
    <local:ResourceKeyConverter x:Key="ResourceKey"/>
    <Style x:Key="ReminderPills" TargetType="ListBox">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></Setter.Value></Setter>
      <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneTime}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Pill" Padding="10,5" CornerRadius="{DynamicResource ControlCorner}"
                          Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <TextBlock Text="{Binding Name, Mode=OneTime}" Foreground="{DynamicResource Ink}" FontSize="12" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSoft}"/>
                      <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ReminderIconGrid" TargetType="ListBox" BasedOn="{StaticResource ReminderPills}">
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Name, Mode=OneTime}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneTime}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Chip" Width="34" Height="34" CornerRadius="{DynamicResource ControlCorner}"
                          Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <local:Glyph x:Name="ChipGlyph" Size="17" Foreground="{DynamicResource Muted}"
                                 Data="{Binding Value, Mode=OneTime, Converter={StaticResource ResourceKey}, ConverterParameter=icon}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentSoft}"/>
                      <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                      <Setter TargetName="ChipGlyph" Property="Foreground" Value="{DynamicResource Accent}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MediaSlider" TargetType="Slider">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Height="20">
          <Grid.Resources>
            <Style TargetType="RepeatButton">
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
            </Style>
          </Grid.Resources>
          <Border Height="4" Background="{DynamicResource Hover}" CornerRadius="2" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Width="12" Height="12">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Accent}" Cursor="Hand"/></ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ConversationList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>
    <Style x:Key="SidebarList" TargetType="ListBox" BasedOn="{StaticResource ConversationList}">
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Foreground" Value="{DynamicResource SidebarInk}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Grid>
                    <Border x:Name="Row" Background="Transparent" CornerRadius="{DynamicResource ControlCorner}" ClipToBounds="True">
                      <Grid>
                        <local:TargetAura x:Name="RowAura" Visibility="Collapsed"/>
                        <ContentPresenter/>
                      </Grid>
                    </Border>
                    <Border x:Name="Marker" Width="3" Height="18" CornerRadius="{DynamicResource MarkerCorner}" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-1,0,0,0" Visibility="Collapsed"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarRowHover}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarRowSelected}"/><Setter TargetName="Marker" Property="Visibility" Value="Visible"/></Trigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                        <Condition Binding="{Binding DataContext.ThemeDetailsEnabled, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True"/>
                      </MultiDataTrigger.Conditions>
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarDetailedRowSelected}"/>
                    </MultiDataTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TitleIcon" TargetType="Button" BasedOn="{StaticResource Icon}">
      <Setter Property="Foreground" Value="{DynamicResource TitleBarMuted}"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TitleBarInk}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="HeaderIcon" TargetType="Button" BasedOn="{StaticResource Icon}">
      <Setter Property="Foreground" Value="{DynamicResource HeaderMuted}"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource HeaderInk}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SidebarIcon" TargetType="Button" BasedOn="{StaticResource Icon}">
      <Setter Property="Foreground" Value="{DynamicResource SidebarMuted}"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource SidebarInk}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="RailNavIcon" TargetType="Button" BasedOn="{StaticResource NavIcon}">
      <Setter Property="Foreground" Value="{DynamicResource RailMuted}"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource RailInk}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SidebarTab" TargetType="RadioButton" BasedOn="{StaticResource Tab}">
      <Setter Property="Foreground" Value="{DynamicResource SidebarMuted}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource SidebarInk}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource SidebarInk}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Faint}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="TransferProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Background" Value="{DynamicResource Hover}"/>
      <Setter Property="Value" Value="{Binding Progress}"/>
      <Setter Property="IsIndeterminate" Value="{Binding IsConnecting}"/>
      <Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource Bool}}"/>
    </Style>
    <DataTemplate x:Key="MessageTemplate">
      <Grid Margin="{DynamicResource MessageRowMargin}" local:MessageMotion.Enable="True">
        <Grid.Style><Style TargetType="Grid"><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding Outgoing}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <StackPanel MaxWidth="{DynamicResource MessageMaxWidth}">
          <TextBlock Text="{Binding SenderName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ContentMuted}" Margin="4,0,0,5" Visibility="{Binding ShowSender, Converter={StaticResource Bool}}"/>
          <Image Source="{Binding ImagePath, Converter={StaticResource ImageFile}}" MaxWidth="320" MaxHeight="320" Stretch="Uniform" local:Rounded.Radius="14" Cursor="Hand"
                 Visibility="{Binding HasImage, Converter={StaticResource Bool}}" MouseLeftButtonUp="MessageImage_Click" ToolTip="Open image" HorizontalAlignment="{Binding HorizontalAlignment, RelativeSource={RelativeSource AncestorType=Grid}}">
            <Image.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open image" Tag="Open" Click="ImageMenu_Click"/>
                <MenuItem Header="Add to chat" Tag="Attach" Click="ImageMenu_Click"/>
                <MenuItem Header="Copy image" Tag="Copy" Click="ImageMenu_Click"/>
                <MenuItem Header="Open in Explorer" Tag="Reveal" Click="ImageMenu_Click"/>
                <MenuItem Header="Save a copy" Tag="Save" Click="ImageMenu_Click"/>
              </ContextMenu>
            </Image.ContextMenu>
          </Image>
          <Border x:Name="FileBubble" Padding="0" Visibility="{Binding HasFile, Converter={StaticResource Bool}}" Cursor="Hand" MouseLeftButtonUp="MessageFile_Click" ToolTip="Show in folder"
                  HorizontalAlignment="{Binding HorizontalAlignment, RelativeSource={RelativeSource AncestorType=Grid}}">
            <Border.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Play" Tag="Play" Click="FileMenu_Click" Visibility="{Binding FileName, Converter={StaticResource MediaFile}}"/>
                <MenuItem Header="Open" Tag="Open" Click="FileMenu_Click"/>
                <MenuItem Header="Show in folder" Tag="Reveal" Click="FileMenu_Click"/>
                <MenuItem Header="Copy file" Tag="Copy" Click="FileMenu_Click"/>
                <MenuItem Header="Save a copy" Tag="Save" Click="FileMenu_Click">
                  <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Style.Triggers>
                    <DataTrigger Binding="{Binding FolderAttachment}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers></Style></MenuItem.Style>
                </MenuItem>
              </ContextMenu>
            </Border.ContextMenu>
            <Border.Style><Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource IncomingBubbleBackground}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource IncomingBubbleBorder}"/>
              <Setter Property="BorderThickness" Value="{DynamicResource IncomingBubbleBorderThickness}"/>
              <Setter Property="CornerRadius" Value="{DynamicResource IncomingFileBubbleCorner}"/>
              <Setter Property="TextElement.Foreground" Value="{DynamicResource IncomingBubbleForeground}"/>
              <Style.Triggers><DataTrigger Binding="{Binding Outgoing}" Value="True">
                <Setter Property="Background" Value="{DynamicResource OutgoingBubbleBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OutgoingBubbleBorder}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource OutgoingBubbleBorderThickness}"/>
                <Setter Property="CornerRadius" Value="{DynamicResource OutgoingFileBubbleCorner}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource OutgoingBubbleForeground}"/>
              </DataTrigger></Style.Triggers>
            </Style></Border.Style>
              <Grid>
              <local:BubbleDecoration IsOutgoing="{Binding Outgoing}"/>
              <StackPanel Margin="14,11">
                <StackPanel Orientation="Horizontal">
                  <local:Glyph Data="{DynamicResource IconFile}" Size="20" Margin="0,0,10,0">
                    <local:Glyph.Style><Style TargetType="local:Glyph"><Setter Property="Foreground" Value="{DynamicResource IncomingFileIconBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Outgoing}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OutgoingFileIconBrush}"/></DataTrigger></Style.Triggers></Style></local:Glyph.Style>
                  </local:Glyph>
                  <TextBlock Text="{Binding FileName}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="{Binding AwaitingAnswer, Converter={StaticResource Bool}}">
                  <Button Content="Decline" Style="{StaticResource Secondary}" Margin="0,0,6,0" Click="MessageDeclineFile_Click" AutomationProperties.Name="Decline file"/>
                  <Button Content="Accept" Style="{StaticResource Primary}" Click="MessageAcceptFile_Click" AutomationProperties.Name="Accept file"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="{Binding CanCancel, Converter={StaticResource Bool}}">
                  <Button Content="Cancel" Style="{StaticResource Secondary}" Background="{DynamicResource Hover}" Click="MessageCancelFile_Click" AutomationProperties.Name="Cancel transfer"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
          <Border x:Name="TextBubble" Padding="0" Visibility="{Binding HasText, Converter={StaticResource Bool}}"
                  HorizontalAlignment="{Binding HorizontalAlignment, RelativeSource={RelativeSource AncestorType=Grid}}">
            <Border.Style><Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource IncomingBubbleBackground}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource IncomingBubbleBorder}"/>
              <Setter Property="BorderThickness" Value="{DynamicResource IncomingBubbleBorderThickness}"/>
              <Setter Property="CornerRadius" Value="{DynamicResource IncomingBubbleCorner}"/>
              <Setter Property="TextElement.Foreground" Value="{DynamicResource IncomingBubbleForeground}"/>
              <Style.Triggers><DataTrigger Binding="{Binding Outgoing}" Value="True">
                <Setter Property="Background" Value="{DynamicResource OutgoingBubbleBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OutgoingBubbleBorder}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource OutgoingBubbleBorderThickness}"/>
                <Setter Property="CornerRadius" Value="{DynamicResource OutgoingBubbleCorner}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource OutgoingBubbleForeground}"/>
              </DataTrigger></Style.Triggers>
            </Style></Border.Style>
            <Grid>
              <local:BubbleDecoration IsOutgoing="{Binding Outgoing}"/>
              <StackPanel Margin="{DynamicResource MessageBubblePadding}">
                <TextBlock Text="ANNOUNCEMENT" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" Visibility="{Binding Broadcast, Converter={StaticResource Bool}}"/>
                <TextBox Text="{Binding Text, Converter={StaticResource LookMessage}, ConverterParameter=caption, Mode=OneWay}" IsReadOnly="True" ContextMenu="{StaticResource ReadOnlyTextContextMenu}" TextWrapping="Wrap" FontSize="{DynamicResource MessageFontSize}" FontFamily="{DynamicResource MessageFontFamily}" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" Background="Transparent" BorderThickness="0" Padding="0"
                         Visibility="{Binding Text, Converter={StaticResource LookMessage}, ConverterParameter=caption_plain}"/>
                <!-- LAN Messenger emoticon codes are drawn as its pictures. -->
                <TextBlock local:SmileyText.Text="{Binding Text, Converter={StaticResource LookMessage}, ConverterParameter=caption}" TextWrapping="Wrap" FontSize="{DynamicResource MessageFontSize}" FontFamily="{DynamicResource MessageFontFamily}" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                           Visibility="{Binding Text, Converter={StaticResource LookMessage}, ConverterParameter=caption_smiley}">
                  <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Copy" Click="CopyMessage_Click"/></ContextMenu></TextBlock.ContextMenu>
                </TextBlock>
                <Grid Visibility="{Binding Text, Converter={StaticResource LookMessage}, ConverterParameter=card}" Margin="0,2,0,0">
                  <Border DataContext="{Binding Text, Converter={StaticResource LookMessage}}"
                          Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                          CornerRadius="{DynamicResource ControlCorner}" Padding="8,7" TextElement.Foreground="{DynamicResource Ink}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="42" Height="32" CornerRadius="6" Background="{Binding CanvasBrush}" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                          <Border Width="13" HorizontalAlignment="Left" Background="{Binding SidebarBrush}"/>
                          <Image Source="{Binding BackgroundPreview}" Stretch="UniformToFill" Opacity="0.82" Visibility="{Binding HasBackground, Converter={StaticResource Bool}}"/>
                          <Ellipse Width="9" Height="9" Fill="{Binding AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"/>
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0" MinWidth="78">
                        <TextBlock Text="{Binding ThemeName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                        <TextBlock Text="{Binding FontLabel}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="150" Visibility="{Binding HasFontLabel, Converter={StaticResource Bool}}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Apply" Style="{StaticResource Primary}" Padding="10,4" FontSize="11.5" Click="ApplyLook_Click" AutomationProperties.Name="Apply theme"/>
                        <Button Content="Copy" Style="{StaticResource Secondary}" Padding="8,4" FontSize="11.5" Margin="6,0,0,0" Click="CopyLook_Click" AutomationProperties.Name="Copy look code"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel x:Name="MessageMetadata" Orientation="Horizontal" Margin="4,4,4,0"
                      HorizontalAlignment="{Binding HorizontalAlignment, RelativeSource={RelativeSource AncestorType=Grid}}">
            <TextBlock Text="{Binding TimeLabel}" FontSize="11" Foreground="{DynamicResource ContentFaint}"/>
            <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource ContentFaint}"/>
            <TextBlock Text="{Binding Delivery}" FontSize="11" MaxWidth="360" TextTrimming="CharacterEllipsis" ToolTip="{Binding Delivery}">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ContentFaint}"/><Style.Triggers><DataTrigger Binding="{Binding DeliveryProblem}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <Button Content="Retry" Padding="8,0" FontSize="11" Foreground="{DynamicResource Accent}" Click="Retry_Click" Visibility="{Binding CanRetry, Converter={StaticResource Bool}}" ToolTip="Retry"/>
            <Button Content="Cancel" Padding="8,0" FontSize="11" Foreground="{DynamicResource Danger}" Click="MessageCancelFile_Click" Visibility="{Binding CanCancelInline, Converter={StaticResource Bool}}" AutomationProperties.Name="Cancel image transfer"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Border x:Name="RootBorder" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Sidebar}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="ChromeColorFinishLayer" Grid.RowSpan="2" Background="{DynamicResource ChromeColorFinishBrush}" IsHitTestVisible="False"/>
      <local:ChromeTexture x:Name="ChromeTextureLayer" Grid.RowSpan="2"
                           Texture="{Binding ChromeTexture}" Intensity="{Binding ChromeTextureIntensity}"
                           Visibility="{Binding ChromeTextureEnabled, Converter={StaticResource Bool}}"/>
      <Grid x:Name="TitleBarGrid" Background="{DynamicResource TitleBarBackground}" TextElement.Foreground="{DynamicResource TitleBarInk}" ClipToBounds="True" MouseLeftButtonDown="TitleBar_MouseDown">
        <local:FxBand x:Name="TitleBarFx" Kinds="{Binding TitleFx}" Intensity="{Binding TitleFxIntensity}"/>
        <local:HeaderEffect x:Name="TitleBarSparkles" Kind="Sparkles" Intensity="{Binding TitleSparklesIntensity}"
                            Visibility="{Binding TitleSparklesEnabled, Converter={StaticResource Bool}}"/>
        <local:HeaderEffect x:Name="TitleBarShimmer" Kind="Shimmer" Intensity="{Binding TitleShimmerIntensity}"
                            Visibility="{Binding TitleShimmerEnabled, Converter={StaticResource Bool}}"/>
        <local:HeaderEffect x:Name="TitleBarComet" Kind="Comet" Intensity="{Binding TitleCometIntensity}"
                            Visibility="{Binding TitleCometEnabled, Converter={StaticResource Bool}}"/>
        <local:HeaderEffect x:Name="TitleBarEqualizer" Kind="Equalizer" Intensity="{Binding TitleEqualizerIntensity}"
                            Visibility="{Binding TitleEqualizerEnabled, Converter={StaticResource Bool}}"/>
        <local:HeaderEffect x:Name="TitleBarLaser" Kind="Laser" Intensity="{Binding TitleLaserIntensity}"
                            Visibility="{Binding TitleLaserEnabled, Converter={StaticResource Bool}}"/>
        <local:HeaderEffect x:Name="TitleBarAurora" Kind="TitleAurora" Intensity="{Binding TitleAuroraIntensity}"
                            Visibility="{Binding TitleAuroraEnabled, Converter={StaticResource Bool}}"/>
        <local:HeaderEffect x:Name="TitleBarWave" Kind="TitleWave" Intensity="{Binding TitleWaveIntensity}"
                            Visibility="{Binding TitleWaveEnabled, Converter={StaticResource Bool}}"/>
        <local:HeaderEffect x:Name="TitleBarWings" Kind="TitleWings" Intensity="{Binding TitleWingsIntensity}"
                            Visibility="{Binding TitleWingsEnabled, Converter={StaticResource Bool}}"/>
        <local:HeaderEffect x:Name="TitleBarReactor" Kind="TitleReactor" Intensity="{Binding TitleReactorIntensity}"
                            Visibility="{Binding TitleReactorEnabled, Converter={StaticResource Bool}}"/>
        <local:ThemeDecoration x:Name="TitleDecoration" Zone="Title" Width="116" HorizontalAlignment="Right" Margin="0,0,145,0"
                               Visibility="{Binding ThemeDetailsEnabled, Converter={StaticResource Bool}}"/>
        <local:SceneEffectsLayer Zone="title" Items="{Binding SceneEffects}"/>
        <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
          <Image Source="{DynamicResource BrandMark}" Width="20" Height="20" Margin="0,0,9,0"/>
          <TextBlock Text="CydLan" FontSize="13" Foreground="{DynamicResource TitleBarMuted}" VerticalAlignment="Center"/>
          <Button Style="{StaticResource TitleIcon}" Width="32" Height="30" Margin="14,0,0,0" Click="ToggleSidebar_Click" ToolTip="Conversations" AutomationProperties.Name="Toggle conversations sidebar"><local:Glyph Data="{DynamicResource IconSidebar}" Size="17"/></Button>
        </StackPanel>
        <local:SteampunkEngine x:Name="TitleEngine" Width="294" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsHitTestVisible="False" Opacity="{Binding EngineIntensity}"
                              Visibility="{Binding SteampunkEngineEnabled, Converter={StaticResource Bool}}"/>
        <!-- Window controls drawn like Windows' own caption buttons: square, full height, red Close. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
          <Button Style="{StaticResource CaptionButton}" Foreground="{DynamicResource TitleBarInk}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" AutomationProperties.Name="Minimize"/>
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Foreground="{DynamicResource TitleBarInk}" Content="&#xE922;" ToolTip="Maximize" Click="Maximize_Click" AutomationProperties.Name="Maximize"/>
          <Button Style="{StaticResource CaptionCloseButton}" Foreground="{DynamicResource TitleBarInk}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" AutomationProperties.Name="Close"/>
        </StackPanel>
        <Border Height="1" Background="{DynamicResource Line}" VerticalAlignment="Bottom" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition x:Name="PeopleColumn" Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid x:Name="RailGrid" Background="{DynamicResource RailBackground}" TextElement.Foreground="{DynamicResource RailInk}">
          <Grid.RowDefinitions><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="106"/></Grid.RowDefinitions>
          <Border Grid.RowSpan="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
          <local:ThemeDecoration x:Name="RailDecoration" Zone="Rail" Grid.RowSpan="3"
                                 Visibility="{Binding ThemeDetailsEnabled, Converter={StaticResource Bool}}"/>
          <local:SceneEffectsLayer Zone="rail" Grid.RowSpan="3" Items="{Binding SceneEffects}"/>
          <local:RailEffect x:Name="RailBeaconEffect" Kind="Beacon" Grid.RowSpan="3" Intensity="{Binding RailBeaconIntensity}"
                            Visibility="{Binding RailBeaconEnabled, Converter={StaticResource Bool}}"/>
          <local:RailEffect x:Name="RailStreamEffect" Kind="Stream" Grid.RowSpan="3" Intensity="{Binding RailStreamIntensity}"
                            Visibility="{Binding RailStreamEnabled, Converter={StaticResource Bool}}"/>
