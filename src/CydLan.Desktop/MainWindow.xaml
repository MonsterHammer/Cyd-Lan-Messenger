<Window x:Class="CydLan.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource {x:Type Window}}" Title="CydLan" Width="860" Height="580" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Bool"/>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Faint}"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <DataTemplate x:Key="MessageTemplate">
      <Grid Margin="0,0,0,12">
        <Grid.Style><Style TargetType="Grid"><Setter Property="HorizontalAlignment" Value="Left"/>
          <Style.Triggers><DataTrigger Binding="{Binding Outgoing}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers>
        </Style></Grid.Style>
        <StackPanel MaxWidth="420">
          <Border Padding="12,9" CornerRadius="3,10,10,10">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/>
              <Style.Triggers><DataTrigger Binding="{Binding Outgoing}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="CornerRadius" Value="10,3,10,10"/></DataTrigger></Style.Triggers>
            </Style></Border.Style>
            <StackPanel>
              <TextBlock Text="ANNOUNCEMENT" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="9" Margin="0,0,0,5" Visibility="{Binding Broadcast, Converter={StaticResource Bool}}"/>
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="19" FontSize="12"/>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="3,4,3,0">
            <TextBlock Text="{Binding TimeLabel}" FontSize="9" Foreground="{StaticResource Faint}"/>
            <TextBlock Text=" · " FontSize="9" Foreground="{StaticResource Faint}"/>
            <TextBlock Text="{Binding Delivery}" FontSize="9" Foreground="{StaticResource Faint}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition x:Name="PeopleColumn" Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- Small desktop targets with room between each action. -->
      <Border Background="{StaticResource Rail}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="88"/></Grid.RowDefinitions>
          <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource Accent}" VerticalAlignment="Center">
            <TextBlock Text="c" Foreground="{StaticResource AccentInk}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-5,0,0"/>
          </Border>
          <StackPanel Grid.Row="1" Margin="0,7,0,0">
            <Button x:Name="ChatNav" Content="&#xE8BD;" ToolTip="Conversations" Click="Chat_Click">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavIcon}"><Style.Triggers>
                <DataTrigger Binding="{Binding IsConversationSection}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger>
              </Style.Triggers></Style></Button.Style>
            </Button>
            <Button Content="&#xE77B;" Style="{StaticResource NavIcon}" ToolTip="Find people" Click="People_Click"/>
            <Button Content="&#xE898;" ToolTip="File transfers" Click="Transfers_Click">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavIcon}"><Style.Triggers>
                <DataTrigger Binding="{Binding TransfersOpen}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger>
              </Style.Triggers></Style></Button.Style>
            </Button>
            <Button Content="&#xE789;" ToolTip="Broadcast preview" Click="Broadcast_Click">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavIcon}"><Style.Triggers>
                <DataTrigger Binding="{Binding IsBroadcastSection}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger>
              </Style.Triggers></Style></Button.Style>
            </Button>
          </StackPanel>
          <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,10">
            <Button Content="&#xE713;" Style="{StaticResource NavIcon}" ToolTip="Preferences" Click="Settings_Click"/>
            <Button Padding="0" Width="28" Height="28" Background="{StaticResource Avatar}" Click="Settings_Click" ToolTip="Your profile">
              <TextBlock Text="{Binding ProfileInitial}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="46"/><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
          <Grid Margin="14,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="cydlan" FontSize="21" FontWeight="SemiBold"/>
            <Border Grid.Column="1" Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="5,3" VerticalAlignment="Center">
              <TextBlock Text="PREVIEW" Foreground="{StaticResource Accent}" FontSize="8" FontWeight="SemiBold"/>
            </Border>
          </Grid>
          <Border Grid.Row="1" Margin="12,3,12,9" Background="{StaticResource Input}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
            <Grid>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="9,0,0,0"/>
              <TextBox x:Name="PeopleSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="24,0,0,0" Background="Transparent" BorderThickness="0" Padding="5,7" FontSize="11" ToolTip="Search people or message history"/>
              <TextBlock Text="Search conversations" Margin="30,0,0,0" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="14,0,8,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="MESSAGES" Style="{StaticResource Caption}"/>
              <TextBlock Text="{Binding OnlineCount}" Foreground="{StaticResource Accent}" FontSize="9" Margin="7,0,0,0"/>
            </StackPanel>
            <Button Content="&#xE72C;" Style="{StaticResource Icon}" HorizontalAlignment="Right" Width="24" Height="24" FontSize="11" ToolTip="Refresh preview" Click="Refresh_Click"/>
          </Grid>
          <ListBox Grid.Row="3" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPeer}" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate><DataTemplate>
              <Grid Margin="9,11">
                <Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/><ColumnDefinition Width="17"/></Grid.ColumnDefinitions>
                <Grid Width="30" Height="30" HorizontalAlignment="Left">
                  <Border Background="{StaticResource Avatar}" CornerRadius="9"><TextBlock Text="{Binding Initials}" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <Ellipse Width="8" Height="8" Stroke="{StaticResource Sidebar}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource Faint}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Online}" Value="True"><Setter Property="Fill" Value="{StaticResource Online}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="busy"><Setter Property="Fill" Value="{StaticResource Away}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="away"><Setter Property="Fill" Value="{StaticResource Away}"/></DataTrigger>
                      </Style.Triggers>
                    </Style></Ellipse.Style>
                  </Ellipse>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Preview}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource Accent}" CornerRadius="6" VerticalAlignment="Center" Height="16">
                  <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Unread}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <TextBlock Text="{Binding Unread}" Foreground="{StaticResource AccentInk}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,9">
            <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" Margin="0,0,7,0"/><TextBlock Text="Offline design" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel><TextBlock Text="Sample contacts only" Foreground="{StaticResource Faint}" FontSize="9" Margin="12,3,0,0"/></StackPanel>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Background="{StaticResource Canvas}" MouseLeftButtonDown="TitleBar_MouseDown">
          <TextBlock Text="WORKSPACE" Style="{StaticResource Caption}" FontSize="8" Margin="16,0,0,0" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="&#xE921;" Style="{StaticResource Icon}" Width="32" Height="28" FontSize="9" ToolTip="Minimize" Click="Minimize_Click"/>
            <Button Content="&#xE922;" Style="{StaticResource Icon}" Width="32" Height="28" FontSize="9" ToolTip="Maximize / restore" Click="Maximize_Click"/>
            <Button Content="&#xE8BB;" Style="{StaticResource Icon}" Width="32" Height="28" FontSize="9" ToolTip="Close to tray" Click="Close_Click"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
          <Grid Margin="16,0,12,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding ChatTitle}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding ChatSubtitle}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
              <Button Content="&#xE721;" Style="{StaticResource Icon}" ToolTip="Search this conversation" Click="SearchMessages_Click"/>
              <Button Content="&#xE946;" Style="{StaticResource Icon}" ToolTip="Show / hide contact details" Click="Details_Click" IsEnabled="{Binding HasPeer}"/>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="2" Visibility="{Binding ChatOpen, Converter={StaticResource Bool}}">
          <Grid x:Name="ChatContentGrid">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="MessageSearchBox" Text="{Binding MessageSearch, UpdateSourceTrigger=PropertyChanged}" Margin="16,10,16,0" Visibility="Collapsed" ToolTip="Search messages in this conversation"/>
            <Grid Grid.Row="1">
              <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto" Padding="16,18,16,8">
                <StackPanel>
                  <TextBlock Text="SAMPLE CONVERSATION" Foreground="{StaticResource Faint}" FontSize="8" HorizontalAlignment="Center" Margin="0,0,0,18" Visibility="{Binding HasPeer, Converter={StaticResource Bool}}"/>
                  <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}"/>
                </StackPanel>
              </ScrollViewer>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Visibility="{Binding NoPeer, Converter={StaticResource Bool}}" Margin="22">
                <Border Background="{StaticResource AccentSoft}" CornerRadius="16" Width="56" Height="56"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="Start a conversation." FontSize="19" FontWeight="SemiBold" TextAlignment="Center" Margin="0,18,0,9"/>
                <TextBlock Text="Choose a sample contact to explore the design." TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="20" TextWrapping="Wrap"/>
                <TextBlock Text="Offline preview · no LAN connection" FontSize="10" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
              </StackPanel>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Visibility="{Binding Broadcasting, Converter={StaticResource Bool}}" Margin="22">
                <TextBlock Text="&#xE789;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="30" HorizontalAlignment="Center"/>
                <TextBlock Text="Let everyone know." FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,10"/>
                <TextBlock Text="Preview an announcement. Nothing is sent to the network." TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </Grid>
            <TextBlock Grid.Row="2" Text="{Binding SelectedPeer.Typing}" Foreground="{StaticResource Muted}" FontSize="10" Margin="20,0,20,3"/>
            <Border Grid.Row="3" Background="{StaticResource Input}" Margin="14,0,14,12" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="5">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                <TextBox x:Name="Composer" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="8,8" MinHeight="34" MaxHeight="96" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="32000" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanCompose}" PreviewKeyDown="Composer_KeyDown" TextChanged="Composer_TextChanged" ToolTip="Enter sends; Shift+Enter starts a new line."/>
                <TextBlock Text="Write a message…" Foreground="{StaticResource Faint}" Margin="8,8,0,0" IsHitTestVisible="False">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Draft}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal"><Button Content="&#xE723;" Style="{StaticResource Icon}" Width="28" Height="28" ToolTip="File sharing preview" Click="Attach_Click" IsEnabled="{Binding HasPeer}"/><Button Content="&#xE899;" Style="{StaticResource Icon}" Width="28" Height="28" ToolTip="Insert a smile" Click="Emoji_Click"/></StackPanel>
                  <TextBlock Grid.Column="1" Text="Enter to send" FontSize="9" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                  <Button Grid.Column="2" Content="Send ↗" Style="{StaticResource Primary}" Padding="12,4" Height="28" FontSize="11" IsEnabled="{Binding CanCompose}" Click="Send_Click"/>
                </Grid>
              </Grid>
            </Border>
          </Grid>
          <!-- An optional drawer; never reserves space until requested. -->
          <Border x:Name="DetailsPanel" Visibility="Collapsed" Width="220" HorizontalAlignment="Right" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,14">
              <Grid><TextBlock Text="CONTACT DETAILS" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Content="&#xE8BB;" Style="{StaticResource Icon}" Width="24" Height="24" FontSize="10" HorizontalAlignment="Right" ToolTip="Close details" Click="Details_Click"/></Grid>
              <Border Width="46" Height="46" Background="{StaticResource Avatar}" CornerRadius="14" Margin="0,18,0,12"><TextBlock Text="{Binding SelectedPeer.Initials}" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="{Binding SelectedPeer.Name}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"/>
              <TextBlock Text="{Binding SelectedPeer.Presence}" Foreground="{StaticResource Accent}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,16"/>
              <Border Background="{StaticResource AccentSoft}" Padding="8,7" CornerRadius="5"><TextBlock Text="{Binding ConnectionLabel}" FontSize="10" Foreground="{StaticResource Accent}" TextAlignment="Center"/></Border>
              <TextBlock Text="DEVICE ADDRESS" Style="{StaticResource Caption}" Margin="0,20,0,6"/><TextBlock Text="{Binding SelectedPeer.Address}" FontSize="11"/>
              <TextBlock Text="CLIENT" Style="{StaticResource Caption}" Margin="0,18,0,6"/><TextBlock Text="{Binding SelectedPeer.Version}" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="PRIVACY" Style="{StaticResource Caption}" Margin="0,18,0,6"/><TextBlock Text="{Binding ConnectionPrivacy}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" LineHeight="18"/>
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
        <Grid Grid.Row="2" Visibility="{Binding TransfersOpen, Converter={StaticResource Bool}}">
          <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="16,16,16,0"><TextBlock Text="File transfers" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Sample files · nothing is sent or downloaded" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel>
          <ScrollViewer Grid.Row="1" Padding="14,0,14,14" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Transfers}"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="12">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Top"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DirectionLabel}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                    <TextBlock FontSize="10" Foreground="{StaticResource Faint}" Margin="0,4,0,8" TextWrapping="Wrap"><Run Text="{Binding SizeLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding State, Mode=OneWay}"/></TextBlock>
                    <ProgressBar Value="{Binding Progress}" Height="3" BorderThickness="0" Foreground="{StaticResource Accent}" Background="{StaticResource Hover}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="Waiting for approval"/><Condition Binding="{Binding Outgoing}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
                      <Button Content="Decline" FontSize="11" Click="DeclineFile_Click"/><Button Content="Save file" Style="{StaticResource Primary}" FontSize="11" Click="AcceptFile_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="1" Text="No transfers yet." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Transfers.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid>
        <StackPanel Grid.Row="3">
          <Border Background="{StaticResource AccentSoft}" Padding="10,8" Margin="14,0,14,8" CornerRadius="6">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Toast}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Toast}" Foreground="{StaticResource Accent}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="×" Padding="4,0" Click="DismissToast_Click"/></Grid>
          </Border>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6"><TextBlock Text="OFFLINE PREVIEW · NO LAN CONNECTION" FontSize="8" Foreground="{StaticResource Faint}"/></Border>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
