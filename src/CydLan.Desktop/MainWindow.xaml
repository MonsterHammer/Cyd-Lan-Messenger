                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:ReminderRow}">
                    <Border x:Name="Card" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource ComposerCorner}" Padding="14,12" Margin="0,0,0,10"
                            BorderBrush="Transparent" BorderThickness="1.5" Cursor="Hand" Tag="{Binding Id}" MouseLeftButtonUp="ReminderCard_Click"
                            AutomationProperties.Name="{Binding Title}">
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Edit" Tag="{Binding Id}" Click="ReminderEdit_Click"/>
                          <MenuItem Header="Done" Tag="{Binding Id}" Click="ReminderDone_Click" IsEnabled="{Binding CanAct}"/>
                          <MenuItem Header="Snooze">
                            <MenuItem Header="5 minutes" Tag="{Binding Id}" CommandParameter="5" Click="ReminderSnooze_Click"/>
                            <MenuItem Header="10 minutes" Tag="{Binding Id}" CommandParameter="10" Click="ReminderSnooze_Click"/>
                            <MenuItem Header="30 minutes" Tag="{Binding Id}" CommandParameter="30" Click="ReminderSnooze_Click"/>
                            <MenuItem Header="1 hour" Tag="{Binding Id}" CommandParameter="60" Click="ReminderSnooze_Click"/>
                          </MenuItem>
                          <MenuItem Header="Skip today" Tag="{Binding Id}" Click="ReminderSkip_Click"/>
                          <MenuItem Header="Undo done" Tag="{Binding Id}" Click="ReminderUndo_Click" IsEnabled="{Binding IsDone}"/>
                          <MenuItem Header="Turned on" Tag="{Binding Id}" IsCheckable="True" IsChecked="{Binding Enabled, Mode=OneWay}" Click="ReminderToggle_Click"/>
                          <Separator/>
                          <MenuItem Header="Delete" Tag="{Binding Id}" Click="ReminderDelete_Click"/>
                        </ContextMenu>
                      </Border.ContextMenu>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="IconDisc" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left" VerticalAlignment="Top">
                          <local:Glyph x:Name="IconGlyph" Data="{Binding Icon, Converter={StaticResource ResourceKey}}" Size="18" Foreground="{DynamicResource Accent}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                          <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Schedule}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding HasNote, Converter={StaticResource Bool}}"/>
                          <WrapPanel Margin="0,7,0,0">
                            <Border x:Name="StateChip" CornerRadius="{DynamicResource ControlCorner}" Padding="7,2" Background="{DynamicResource Hover}" Margin="0,0,6,0">
                              <TextBlock x:Name="StateText" Text="{Binding StateLabel}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                            </Border>
                            <Border CornerRadius="{DynamicResource ControlCorner}" Padding="7,2" Background="{DynamicResource AccentSoft}" Margin="0,0,6,0" Visibility="{Binding HasStreak, Converter={StaticResource Bool}}">
                              <TextBlock Text="{Binding StreakLabel}" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding TotalLabel}" FontSize="11" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <Button Content="Done" Style="{StaticResource Primary}" Padding="12,5" MinWidth="76" Tag="{Binding Id}" Click="ReminderDone_Click"
