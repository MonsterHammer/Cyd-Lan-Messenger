                    <ListBox x:Name="ReminderIconBox" Style="{StaticResource ReminderIconGrid}" SelectedValuePath="Value" Margin="0,0,0,6" AutomationProperties.Name="Reminder icon"/>
                    <TextBlock Text="When" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,5"/>
                    <ListBox x:Name="ReminderRepeatBox" Style="{StaticResource ReminderPills}" SelectedValuePath="Value" SelectionChanged="ReminderRepeat_Changed" Margin="0,0,0,4" AutomationProperties.Name="Reminder repeat"/>
                    <StackPanel x:Name="ReminderDatePanel" Orientation="Horizontal" Margin="0,2,0,8">
                      <Button Style="{StaticResource Icon}" Width="28" Height="28" Click="ReminderDatePrev_Click" ToolTip="Previous day" AutomationProperties.Name="Previous day"><local:Glyph Data="{DynamicResource IconChevronLeft}" Size="14"/></Button>
                      <TextBlock x:Name="ReminderDateText" MinWidth="128" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                      <Button Style="{StaticResource Icon}" Width="28" Height="28" Click="ReminderDateNext_Click" ToolTip="Next day" AutomationProperties.Name="Next day"><local:Glyph Data="{DynamicResource IconChevronRight}" Size="14"/></Button>
                      <Button Content="+1 week" Style="{StaticResource Secondary}" Padding="8,4" Margin="8,0,0,0" Click="ReminderDateWeek_Click" AutomationProperties.Name="One week later"/>
                    </StackPanel>
                    <ListBox x:Name="ReminderDaysBox" Style="{StaticResource ReminderPills}" SelectionMode="Multiple" SelectedValuePath="Value" SelectionChanged="ReminderField_Changed" Margin="0,2,0,4" AutomationProperties.Name="Reminder days of week"/>
                    <StackPanel x:Name="ReminderMonthPanel" Orientation="Horizontal" Margin="0,2,0,8">
                      <Button Style="{StaticResource Icon}" Width="28" Height="28" Click="ReminderMonthPrev_Click" ToolTip="Earlier day" AutomationProperties.Name="Earlier day of month"><local:Glyph Data="{DynamicResource IconChevronLeft}" Size="14"/></Button>
                      <TextBlock x:Name="ReminderMonthText" MinWidth="128" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                      <Button Style="{StaticResource Icon}" Width="28" Height="28" Click="ReminderMonthNext_Click" ToolTip="Later day" AutomationProperties.Name="Later day of month"><local:Glyph Data="{DynamicResource IconChevronRight}" Size="14"/></Button>
                    </StackPanel>
                    <Grid Margin="0,4,0,4">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="From" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>
                        <TextBox x:Name="ReminderStartBox" Padding="9,7" Text="09:00" TextChanged="ReminderField_Changed" AutomationProperties.Name="Reminder start time"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Until" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>
                        <TextBox x:Name="ReminderEndBox" Padding="9,7" TextChanged="ReminderField_Changed" AutomationProperties.Name="Reminder end time"/>
                      </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,4,0,6">
                      <Button Content="In 5 min" Style="{StaticResource Secondary}" Padding="8,4" Margin="0,0,6,6" Tag="5" Click="ReminderQuickTime_Click"/>
                      <Button Content="In 30 min" Style="{StaticResource Secondary}" Padding="8,4" Margin="0,0,6,6" Tag="30" Click="ReminderQuickTime_Click"/>
                      <Button Content="In 1 hour" Style="{StaticResource Secondary}" Padding="8,4" Margin="0,0,6,6" Tag="60" Click="ReminderQuickTime_Click"/>
                      <Button Content="Tomorrow 9 AM" Style="{StaticResource Secondary}" Padding="8,4" Margin="0,0,6,6" Tag="tomorrow" Click="ReminderQuickTime_Click"/>
                    </WrapPanel>
                    <TextBlock Text="Remind every" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,2,0,5"/>
                    <ListBox x:Name="ReminderEveryBox" Style="{StaticResource ReminderPills}" SelectedValuePath="Value" SelectionChanged="ReminderField_Changed" Margin="0,0,0,6" AutomationProperties.Name="Reminder interval"/>
                    <TextBlock Text="Priority" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,2,0,5"/>
                    <ListBox x:Name="ReminderPriorityBox" Style="{StaticResource ReminderPills}" SelectedValuePath="Value" Margin="0,0,0,8" AutomationProperties.Name="Reminder priority"/>
                    <TextBlock x:Name="ReminderSummaryText" FontSize="12" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                    <TextBlock x:Name="ReminderErrorText" FontSize="12" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>
                    <DockPanel Margin="0,8,0,0" LastChildFill="False">
                      <Button x:Name="ReminderDeleteButton" DockPanel.Dock="Left" Content="Delete" Style="{StaticResource Secondary}" Click="ReminderEditorDelete_Click" AutomationProperties.Name="Delete this reminder"/>
                      <Button x:Name="ReminderSaveButton" DockPanel.Dock="Right" Content="Save" Style="{StaticResource Primary}" Click="ReminderSave_Click" AutomationProperties.Name="Save reminder"/>
                      <Button x:Name="ReminderTestButton" DockPanel.Dock="Right" Content="Try it" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="ReminderTest_Click" AutomationProperties.Name="Preview this reminder on the companion"/>
                    </DockPanel>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>
            <Grid x:Name="MediaSectionGrid" Grid.Row="1" Visibility="{Binding MediaOpen, Converter={StaticResource Bool}}" Margin="26,12,26,16">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border x:Name="MediaStageBorder" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                      CornerRadius="{DynamicResource OverlayCorner}" ClipToBounds="True">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Height" Value="152"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCurrentVideo}" Value="True">
                        <Setter Property="Height" Value="216"/>
                        <Setter Property="Background" Value="#0A0D14"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <MediaElement x:Name="MediaPlayerElement" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                                Stretch="Uniform" Cursor="Hand"
                                MouseLeftButtonDown="MediaVideoStage_Click"
                                MediaOpened="MediaPlayer_Opened" MediaEnded="MediaPlayer_Ended" MediaFailed="MediaPlayer_Failed">
                    <MediaElement.Style>
                      <Style TargetType="MediaElement">
                        <Setter Property="Width" Value="1"/>
                        <Setter Property="Height" Value="1"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Setter Property="VerticalAlignment" Value="Top"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCurrentVideo}" Value="True">
                            <Setter Property="Width" Value="NaN"/>
                            <Setter Property="Height" Value="NaN"/>
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="IsHitTestVisible" Value="True"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </MediaElement.Style>
                  </MediaElement>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasCurrentMedia}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <local:Glyph Data="{DynamicResource IconMedia}" Size="36" Foreground="{DynamicResource Accent}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                      <Button Content="Add files" Style="{StaticResource Primary}" Padding="14,7" Margin="0,0,8,0" Click="AddMediaFiles_Click"/>
                      <Button Content="Add folder" Style="{StaticResource Secondary}" Padding="14,7" Click="AddMediaFolder_Click"/>
                    </StackPanel>
                  </StackPanel>
                  <Grid Margin="20,16">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCurrentAudio}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="152"/></Grid.ColumnDefinitions>
                    <Border Width="68" Height="68" CornerRadius="{DynamicResource PanelCorner}" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                      <local:Glyph Data="{DynamicResource IconMedia}" Size="28" Foreground="{DynamicResource Accent}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,14,0">
                      <TextBlock Text="{Binding CurrentMedia.Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding CurrentMedia.MetaLabel}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <local:AudioVisualizer Grid.Column="2" Height="62" VerticalAlignment="Center" IsPlaying="{Binding IsCurrentAudioPlaying}"/>
                  </Grid>
                </Grid>
              </Border>
              <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                      CornerRadius="{DynamicResource PanelCorner}" Padding="14,10" Margin="0,10,0,10">
                <StackPanel>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding MediaPositionLabel}" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" MinWidth="36"/>
                    <Slider x:Name="MediaSeekSlider" Grid.Column="1" Style="{StaticResource MediaSlider}" Margin="10,0"
                            Minimum="0" Maximum="{Binding MediaDurationSeconds}" Value="{Binding MediaPositionSeconds, Mode=OneWay}"
                            IsEnabled="{Binding HasCurrentMedia}"
                            PreviewMouseDown="MediaSeek_PreviewMouseDown" PreviewMouseUp="MediaSeek_PreviewMouseUp" ValueChanged="MediaSeek_ValueChanged"
                            AutomationProperties.Name="Media position"/>
                    <TextBlock Grid.Column="2" Text="{Binding MediaDurationLabel}" FontSize="11.5" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="MediaSpeedButton" Content="{Binding MediaSpeedLabel}" Style="{StaticResource Secondary}" Padding="9,4" FontSize="11.5"
                            Background="{DynamicResource Hover}" VerticalAlignment="Center" Click="MediaSpeed_Click" ToolTip="Speed" AutomationProperties.Name="Playback speed"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Button Click="MediaShuffle_Click" ToolTip="Shuffle" AutomationProperties.Name="Shuffle">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Icon}"><Style.Triggers><DataTrigger Binding="{Binding MediaShuffle}" Value="True"><Setter Property="Background" Value="{DynamicResource NavSelected}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <local:Glyph Data="{DynamicResource IconShuffle}" Size="15"/>
                      </Button>
                      <Button Style="{StaticResource Icon}" Click="MediaPrev_Click" Margin="2,0" ToolTip="Previous" AutomationProperties.Name="Previous track"><local:Glyph Data="{DynamicResource IconPrev}" Size="16"/></Button>
                      <Button x:Name="MediaPlayButton" Style="{StaticResource Primary}" Width="38" Height="34" Padding="0" Margin="4,0" Click="MediaPlayPause_Click" ToolTip="{Binding MediaPlayLabel}" AutomationProperties.Name="Play or Pause">
                        <local:Glyph Size="16" Foreground="{DynamicResource AccentInk}">
                          <local:Glyph.Style><Style TargetType="local:Glyph"><Setter Property="Data" Value="{DynamicResource IconPlay}"/><Style.Triggers><DataTrigger Binding="{Binding IsMediaPlaying}" Value="True"><Setter Property="Data" Value="{DynamicResource IconPause}"/></DataTrigger></Style.Triggers></Style></local:Glyph.Style>
                        </local:Glyph>
                      </Button>
                      <Button Style="{StaticResource Icon}" Click="MediaNext_Click" Margin="2,0" ToolTip="Next" AutomationProperties.Name="Next track"><local:Glyph Data="{DynamicResource IconNext}" Size="16"/></Button>
                      <Button Style="{StaticResource Icon}" Click="MediaStop_Click" IsEnabled="{Binding HasCurrentMedia}" ToolTip="Stop" AutomationProperties.Name="Stop playback"><local:Glyph Data="{DynamicResource IconStop}" Size="14"/></Button>
                      <Button Click="MediaRepeat_Click" ToolTip="{Binding MediaRepeatLabel}" AutomationProperties.Name="Repeat mode">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Icon}"><Style.Triggers><DataTrigger Binding="{Binding MediaRepeatActive}" Value="True"><Setter Property="Background" Value="{DynamicResource NavSelected}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <local:Glyph Data="{DynamicResource IconRepeat}" Size="15"/>
                      </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Click="MediaMute_Click" ToolTip="Mute" AutomationProperties.Name="Mute volume">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Icon}"><Style.Triggers><DataTrigger Binding="{Binding MediaMuted}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <local:Glyph Size="16">
                          <local:Glyph.Style><Style TargetType="local:Glyph"><Setter Property="Data" Value="{DynamicResource IconVolume}"/><Style.Triggers><DataTrigger Binding="{Binding MediaMuted}" Value="True"><Setter Property="Data" Value="{DynamicResource IconMute}"/></DataTrigger></Style.Triggers></Style></local:Glyph.Style>
                        </local:Glyph>
                      </Button>
                      <Slider x:Name="MediaVolumeSlider" Style="{StaticResource MediaSlider}" Width="68" Minimum="0" Maximum="1"
                              Value="{Binding MediaVolume}" VerticalAlignment="Center" Margin="2,0,0,0" AutomationProperties.Name="Volume"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Grid Grid.Row="2">
                <ListBox x:Name="MediaPlaylistBox" Style="{StaticResource ConversationList}" ItemsSource="{Binding MediaView}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Media playlist">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:MediaItem}">
                      <Border Padding="12,9" Margin="0,0,0,6" CornerRadius="{DynamicResource PanelCorner}" BorderThickness="1" MouseLeftButtonDown="MediaItem_DoubleClick">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Surface}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowSelected}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Play" Click="MediaPlayItem_Click"/>
                            <MenuItem Header="Send to chat" Click="MediaSendToChat_Click"/>
                            <MenuItem Header="Show in folder" Click="MediaRevealItem_Click"/>
                            <MenuItem Header="Remove" Click="MediaRemoveItem_Click"/>
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <local:Glyph Size="17" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <local:Glyph.Style>
                              <Style TargetType="local:Glyph">
                                <Setter Property="Data" Value="{DynamicResource IconMedia}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter Property="Data" Value="{DynamicResource IconVideo}"/></DataTrigger>
                                  <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </local:Glyph.Style>
                          </local:Glyph>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding MetaLabel}" FontSize="11.5" Foreground="{DynamicResource Faint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Icon}" Width="28" Height="28" Click="MediaPlayItem_Click" ToolTip="Play" AutomationProperties.Name="Play track"><local:Glyph Data="{DynamicResource IconPlay}" Size="13"/></Button>
                            <Button Style="{StaticResource Icon}" Width="28" Height="28" Click="MediaRemoveItem_Click" ToolTip="Remove" AutomationProperties.Name="Remove track"><local:Glyph Data="{DynamicResource IconTrash}" Size="13"/></Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No media" Foreground="{DynamicResource ContentMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NoMediaShown}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
            </Grid>
            <StackPanel Grid.Row="1" VerticalAlignment="Top" Panel.ZIndex="20">
              <Border x:Name="ToastBanner" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="13,10" Margin="26,10,26,0" CornerRadius="{DynamicResource PanelCorner}" MaxWidth="760"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Toast}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Toast}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource Icon}" Width="24" Height="24" Click="DismissToast_Click" ToolTip="Dismiss notification"><local:Glyph Data="{DynamicResource IconClose}" Size="13"/></Button></Grid></Border>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      <local:ChatEffects x:Name="EffectLayer" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True"/>
      <!-- Dims everything behind an open popup so the popup reads as a separate layer. -->
      <Border x:Name="Scrim" Grid.RowSpan="2" Background="{DynamicResource Scrim}" Visibility="Collapsed" Opacity="0"/>
    </Grid>
  </Border>
</Window>
