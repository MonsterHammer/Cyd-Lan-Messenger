<UserControl x:Class="CydLan.Desktop.PetArenaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CydLan.Desktop"
             AutomationProperties.Name="Pets">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource PanelCorner}"/>
      <Setter Property="Padding" Value="14,12"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Margin" Value="2,0,0,6"/>
    </Style>
    <Style x:Key="Track" TargetType="Border">
      <Setter Property="Height" Value="8"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="{DynamicResource Canvas}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Fill" TargetType="Border">
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Width" Value="0"/>
    </Style>
    <Style x:Key="MoveButton" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="104"/>
    </Style>
  </UserControl.Resources>

  <Grid>
      <!-- Lobby -->
      <Grid x:Name="LobbyPanel">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border CornerRadius="{DynamicResource PanelCorner}" Background="{DynamicResource ChatColorFinishBrush}" Margin="6" Height="170" ClipToBounds="True"
                        Cursor="Hand" MouseLeftButtonDown="MyPet_Click">
                  <local:FloatingPetVisual x:Name="MyPetVisual" Width="170" Height="150" VerticalAlignment="Bottom"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,14,16,12">
                  <DockPanel>
                    <Border x:Name="ElementBadge" DockPanel.Dock="Right" Padding="8,2" CornerRadius="9" VerticalAlignment="Center">
                      <TextBlock x:Name="ElementBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="#1D2326"/>
                    </Border>
                    <TextBlock x:Name="MyNameText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                  <TextBlock x:Name="LevelText" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,8"/>
                  <DockPanel Margin="0,0,0,3">
                    <TextBlock x:Name="XpText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Faint}"/>
                    <TextBlock Text="XP" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                  </DockPanel>
                  <Border x:Name="XpTrack" Style="{StaticResource Track}">
                    <Border x:Name="XpFill" Style="{StaticResource Fill}" Background="{DynamicResource Accent}"/>
                  </Border>
                  <DockPanel Margin="0,8,0,3">
                    <TextBlock x:Name="FullText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Faint}"/>
                    <TextBlock Text="Fullness" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                  </DockPanel>
                  <Border x:Name="FullTrack" Style="{StaticResource Track}">
                    <Border x:Name="FullFill" Style="{StaticResource Fill}" Background="#F59E0B"/>
                  </Border>
                  <TextBlock x:Name="RecordText" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,9,0,0"/>
                  <TextBlock x:Name="BoostText" FontSize="11.5" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="Gear" Style="{StaticResource SectionTitle}" Margin="2,14,0,6"/>
            <ItemsControl x:Name="GearSlots">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="8,7" BorderBrush="{Binding RarityBrush}" BorderThickness="1.5">
                    <StackPanel>
                      <TextBlock Text="{Binding SlotName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Faint}"/>
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      <TextBlock Text="{Binding CardName}" FontSize="10.5" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"/>
                      <Button Content="Remove" Style="{StaticResource Secondary}" Padding="0,2" FontSize="10.5" Margin="0,6,0,0" Tag="{Binding Slot}"
                              Click="Unequip_Click" Visibility="{Binding RemoveVisibility}" AutomationProperties.Name="{Binding RemoveName}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,14,0,6">
              <Button x:Name="GearPackButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="10,3" FontSize="11.5" Click="GearPack_Click"/>
              <TextBlock x:Name="BagTitle" Style="{StaticResource SectionTitle}" VerticalAlignment="Bottom" Margin="2,0,0,0"/>
            </DockPanel>
            <TextBlock x:Name="PackResultText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,0,0,6" Visibility="Collapsed"/>
            <ItemsControl x:Name="BagList">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="10,8" BorderBrush="{Binding RarityBrush}" BorderThickness="1.5">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SlotName}" FontSize="10.5" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <TextBlock Text="{Binding StatText}" FontSize="10.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      <TextBlock Text="{Binding CardLine}" FontSize="10.5" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="{Binding EquipText}" Style="{StaticResource Primary}" Padding="0,3" FontSize="11" Tag="{Binding Uid}" Click="Equip_Click" IsEnabled="{Binding CanEquip}" AutomationProperties.Name="{Binding EquipName}"/>
                        <Button Grid.Column="2" Content="{Binding SellText}" Style="{StaticResource Secondary}" Padding="0,3" FontSize="11" Tag="{Binding Uid}" Click="Sell_Click" IsEnabled="{Binding CanSell}" AutomationProperties.Name="{Binding SellName}"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Element" Style="{StaticResource SectionTitle}"/>
                <ComboBox x:Name="ElementBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ElementBox_SelectionChanged" AutomationProperties.Name="Element"/>
                <TextBlock x:Name="StatsLine" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,10,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <DockPanel>
                  <Button x:Name="ResetPointsButton" DockPanel.Dock="Right" Content="Reset" Style="{StaticResource Secondary}" Padding="8,1" FontSize="11" Click="ResetPoints_Click" Margin="0,0,0,4"/>
                  <TextBlock x:Name="PointsTitle" Style="{StaticResource SectionTitle}"/>
                </DockPanel>
                <ItemsControl x:Name="StatRows">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Width="26" Height="22" Padding="0" Content="+" Tag="{Binding Key}"
                                Click="AddPoint_Click" IsEnabled="{Binding CanAdd}" AutomationProperties.Name="{Binding AddName}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Width="28" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>

            <DockPanel Margin="0,14,0,0">
              <Button x:Name="DailyButton" DockPanel.Dock="Right" Content="Daily bonus" Style="{StaticResource Primary}" Padding="10,3" FontSize="11.5" Click="Daily_Click" Margin="0,0,0,6"/>
              <TextBlock Text="Food" Style="{StaticResource SectionTitle}" VerticalAlignment="Bottom"/>
            </DockPanel>
            <ItemsControl x:Name="FoodList">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="8,8,8,8">
                    <StackPanel>
                      <Grid Height="40">
                        <local:FoodIcon Food="{Binding Id}" Width="40" Height="40" HorizontalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="20" Padding="5,0" CornerRadius="8" Background="{DynamicResource AccentSoft}">
                          <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding Effect}" FontSize="10.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="Feed" Style="{StaticResource Primary}" Padding="0,3" FontSize="11" Tag="{Binding Id}" Click="Feed_Click" IsEnabled="{Binding CanFeed}" AutomationProperties.Name="{Binding FeedName}"/>
                        <Button Grid.Column="2" Content="{Binding PriceText}" Style="{StaticResource Secondary}" Padding="0,3" FontSize="11" Tag="{Binding Id}" Click="Buy_Click" IsEnabled="{Binding CanBuy}" AutomationProperties.Name="{Binding BuyName}"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="2">
          <Border DockPanel.Dock="Top" Padding="10,3" CornerRadius="10" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Right" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock x:Name="CoinsText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" AutomationProperties.Name="Coins"/>
          </Border>
          <Button DockPanel.Dock="Top" x:Name="PracticeButton" Content="Card battle" Style="{StaticResource Primary}" Padding="0,9" Click="CardBattle_Click" Margin="0,0,0,6"/>
          <TextBlock DockPanel.Dock="Top" x:Name="CardRecordText" FontSize="11.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
          <StackPanel DockPanel.Dock="Top" x:Name="InvitesSection" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock Text="Challenges" Style="{StaticResource SectionTitle}"/>
            <ItemsControl x:Name="InviteList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,8" BorderBrush="{DynamicResource Accent}">
                    <DockPanel>
                      <local:FloatingPetVisual DockPanel.Dock="Left" Width="48" Height="44" PetStyle="{Binding Appearance}" Margin="0,0,8,0"/>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Decline" Style="{StaticResource Secondary}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Tag="{Binding}" Click="DeclineInvite_Click"/>
                        <Button Content="Battle" Style="{StaticResource Primary}" Padding="8,3" FontSize="11" Tag="{Binding}" Click="AcceptInvite_Click"/>
                      </StackPanel>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PeerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel DockPanel.Dock="Top" x:Name="FriendsArea" Visibility="Collapsed">
          <TextBlock Text="Friends" Style="{StaticResource SectionTitle}"/>
          <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="2,0,0,6" TextWrapping="Wrap"/>
          <TextBlock x:Name="NoFriendsText" Text="No friends online" FontSize="12" Foreground="{DynamicResource Faint}" Margin="2,4,0,0"/>
            <ItemsControl x:Name="FriendList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,0,8">
                    <DockPanel>
                      <local:FloatingPetVisual DockPanel.Dock="Left" Width="44" Height="40" PetStyle="{Binding Appearance}" Margin="0,0,8,0"/>
                      <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Style="{StaticResource Secondary}" Padding="10,3" FontSize="11" VerticalAlignment="Center"
                              Tag="{Binding}" Click="Challenge_Click" AutomationProperties.Name="{Binding ActionName}"/>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" x:Name="DeckTitle" Style="{StaticResource SectionTitle}"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DeckList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="8,6" Margin="0,0,0,6" BorderBrush="{Binding KindBrush}" BorderThickness="1.5">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Cost}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="6,2,0,0"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding Text}" FontSize="10.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Grid>

      <!-- Battle -->
      <Grid x:Name="BattlePanel" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="12,9">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="LeftLevel" DockPanel.Dock="Right" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LeftName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <Border Style="{StaticResource Track}" Height="12" Margin="0,6,0,0" x:Name="LeftHpTrack">
                <Border x:Name="LeftHpFill" Style="{StaticResource Fill}" Background="#22C55E"/>
              </Border>
              <DockPanel Margin="0,3,0,0">
                <TextBlock x:Name="LeftHpText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Muted}"/>
                <TextBlock x:Name="LeftStatus" FontSize="11" Foreground="{DynamicResource Accent}"/>
              </DockPanel>
              <Border Style="{StaticResource Track}" Height="5" Margin="0,3,0,0" x:Name="LeftChargeTrack">
                <Border x:Name="LeftChargeFill" Style="{StaticResource Fill}" CornerRadius="2" Background="#A855F7"/>
              </Border>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,9">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="RightLevel" DockPanel.Dock="Right" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="RightName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <Border Style="{StaticResource Track}" Height="12" Margin="0,6,0,0" x:Name="RightHpTrack">
                <Border x:Name="RightHpFill" Style="{StaticResource Fill}" Background="#22C55E"/>
              </Border>
              <DockPanel Margin="0,3,0,0">
                <TextBlock x:Name="RightHpText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Muted}"/>
                <TextBlock x:Name="RightStatus" FontSize="11" Foreground="{DynamicResource Accent}"/>
              </DockPanel>
              <Border Style="{StaticResource Track}" Height="5" Margin="0,3,0,0" x:Name="RightChargeTrack">
                <Border x:Name="RightChargeFill" Style="{StaticResource Fill}" CornerRadius="2" Background="#A855F7"/>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Border x:Name="StageBorder" Grid.Row="1" Margin="0,12,0,12" CornerRadius="{DynamicResource PanelCorner}" ClipToBounds="True"
                BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop x:Name="SkyTop" Color="#DCEBFF" Offset="0"/>
              <GradientStop x:Name="SkyBottom" Color="#F4F9FF" Offset=".68"/>
              <GradientStop x:Name="GroundTop" Color="#BFE3B4" Offset=".68"/>
              <GradientStop x:Name="GroundBottom" Color="#9FD196" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Canvas x:Name="Stage" SizeChanged="Stage_SizeChanged">
            <local:FloatingPetVisual x:Name="LeftPet" Width="250" Height="224">
              <local:FloatingPetVisual.RenderTransform><TranslateTransform x:Name="LeftMove"/></local:FloatingPetVisual.RenderTransform>
            </local:FloatingPetVisual>
            <local:FloatingPetVisual x:Name="RightPet" Width="250" Height="224">
              <local:FloatingPetVisual.RenderTransform><TranslateTransform x:Name="RightMove"/></local:FloatingPetVisual.RenderTransform>
            </local:FloatingPetVisual>
            <Canvas x:Name="FxLayer" IsHitTestVisible="False"/>
            <Border x:Name="ResultCard" Visibility="Collapsed" Style="{StaticResource Card}" Padding="22,16" MinWidth="260">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="ResultTitle" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ResultReason" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock x:Name="ResultReward" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                  <Button x:Name="RematchButton" Content="Rematch" Style="{StaticResource Secondary}" Padding="14,5" Margin="0,0,8,0" Click="Rematch_Click"/>
                  <Button Content="Done" Style="{StaticResource Primary}" Padding="18,5" Click="Done_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Canvas>
        </Border>

        <TextBlock x:Name="LogText" Grid.Row="2" FontSize="12.5" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="2,0,0,10" MinHeight="18"/>

        <DockPanel Grid.Row="3" x:Name="CardBar" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom">
            <Button x:Name="FightButton" Content="Fight" Style="{StaticResource Primary}" Padding="22,10" FontSize="13" Click="Fight_Click" Margin="0,0,0,8" AutomationProperties.Name="Play chosen cards"/>
            <Button x:Name="CardLeaveButton" Content="Leave" Style="{StaticResource Secondary}" Padding="12,5" Click="CardLeave_Click" AutomationProperties.Name="Leave battle"/>
          </StackPanel>
          <Border DockPanel.Dock="Left" Width="58" Height="58" CornerRadius="29" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"
                  AutomationProperties.Name="Energy">
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="EnergyText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center"/>
              <TextBlock Text="energy" FontSize="9.5" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" Margin="0,-3,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel x:Name="HandPanel" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,16,0,0"/>
        </DockPanel>

        <DockPanel Grid.Row="3" x:Name="MoveRow">
          <Button x:Name="LeaveButton" DockPanel.Dock="Right" Content="Leave" Style="{StaticResource Secondary}" Padding="12,8" Click="Leave_Click" AutomationProperties.Name="Leave battle"/>
          <TextBlock x:Name="TurnText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <StackPanel x:Name="MoveBar" Orientation="Horizontal">
            <Button x:Name="StrikeButton" Style="{StaticResource MoveButton}" Tag="strike" Click="Move_Click"/>
            <Button x:Name="SpecialButton" Style="{StaticResource MoveButton}" Tag="special" Click="Move_Click"/>
            <Button x:Name="GuardButton" Style="{StaticResource MoveButton}" Tag="guard" Click="Move_Click"/>
            <Button x:Name="HealButton" Style="{StaticResource MoveButton}" Tag="heal" Click="Move_Click"/>
            <Button x:Name="UltimateButton" Style="{StaticResource MoveButton}" Tag="ultimate" Click="Move_Click"/>
          </StackPanel>
        </DockPanel>
      </Grid>
  </Grid>
</UserControl>
