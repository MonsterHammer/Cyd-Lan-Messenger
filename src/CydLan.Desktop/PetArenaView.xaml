<UserControl x:Class="CydLan.Desktop.PetArenaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CydLan.Desktop"
             AutomationProperties.Name="Pets">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource PanelCorner}"/>
      <Setter Property="Padding" Value="14,12"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Margin" Value="2,0,0,6"/>
    </Style>
    <Style x:Key="Track" TargetType="Border">
      <Setter Property="Height" Value="8"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="{DynamicResource Canvas}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Fill" TargetType="Border">
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Width" Value="0"/>
    </Style>
    <Style x:Key="MoveButton" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="104"/>
    </Style>
    <Style x:Key="LobbyTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Chip" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="14,5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource Surface}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
      <!-- Lobby: an account strip, then one tab at a time so every tab gets the full width even in the smallest window. -->
      <Grid x:Name="LobbyPanel">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <!-- Account: level and XP belong to the player, not the pet. -->
            <Border Style="{StaticResource Card}" Padding="14,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="MyNameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <DockPanel Margin="0,0,0,3">
                    <TextBlock x:Name="XpText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Faint}"/>
                    <TextBlock x:Name="NextPointText" FontSize="11" Foreground="{DynamicResource Muted}"/>
                  </DockPanel>
                  <Border x:Name="XpTrack" Style="{StaticResource Track}">
                    <Border x:Name="XpFill" Style="{StaticResource Fill}" Background="{DynamicResource Accent}"/>
                  </Border>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="RecordText" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
              </Grid>
            </Border>

            
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
          <RadioButton x:Name="WorldTabButton" Content="World" GroupName="LobbyTab" Style="{StaticResource LobbyTab}" IsChecked="True" Checked="LobbyTab_Checked"/>
          <RadioButton x:Name="TournamentTabButton" Content="Tournament" GroupName="LobbyTab" Style="{StaticResource LobbyTab}" Checked="LobbyTab_Checked"/>
          <RadioButton x:Name="PetTabButton" Content="Pet" GroupName="LobbyTab" Style="{StaticResource LobbyTab}" Checked="LobbyTab_Checked"/>
          <RadioButton x:Name="DeckTabButton" GroupName="LobbyTab" Style="{StaticResource LobbyTab}" Checked="LobbyTab_Checked" AutomationProperties.Name="Deck"/>
          <RadioButton x:Name="ShopTabButton" Content="Shop" GroupName="LobbyTab" Style="{StaticResource LobbyTab}" Checked="LobbyTab_Checked"/>
        </StackPanel>
        <Grid Grid.Row="2">
          <ScrollViewer x:Name="WorldTab" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <!-- World -->
            <Border Style="{StaticResource Card}" Padding="12,10">
              <StackPanel>
                <DockPanel>
                  <Border x:Name="StageBadge" DockPanel.Dock="Right" Padding="8,2" CornerRadius="9" VerticalAlignment="Center">
                    <TextBlock x:Name="StageBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="#1D2326"/>
                  </Border>
                  <StackPanel>
                    <TextBlock x:Name="StageNumberText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                    <TextBlock x:Name="StageNameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
                <ItemsControl x:Name="StageFights" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="8" Padding="6,4" Margin="0,0,0,4" BorderThickness="1.5" BorderBrush="{Binding Edge}" Opacity="{Binding Fade}">
                        <DockPanel>
                          <local:FloatingPetVisual DockPanel.Dock="Left" Width="40" Height="36" PetStyle="{Binding Look}" Margin="0,0,8,0"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource Muted}"/>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="PracticeButton" Content="Fight" Style="{StaticResource Primary}" Padding="0,9" Click="CardBattle_Click" Margin="0,6,0,0"/>
                <Button x:Name="DeckNeededButton" Style="{StaticResource Secondary}" Margin="0,6,0,0" Padding="8,5" Click="DeckNeeded_Click" Visibility="Collapsed" BorderBrush="#EF4444" BorderThickness="1">
                  <TextBlock x:Name="DeckNeededText" Foreground="#EF4444" FontWeight="SemiBold" FontSize="11.5"/>
                </Button>
                <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="2,6,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>

            
            <StackPanel x:Name="InvitesSection" Margin="0,12,0,0" Visibility="Collapsed">
              <TextBlock Text="Challenges" Style="{StaticResource SectionTitle}"/>
              <ItemsControl x:Name="InviteList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,8" BorderBrush="{DynamicResource Accent}">
                      <DockPanel>
                        <local:FloatingPetVisual DockPanel.Dock="Left" Width="48" Height="44" PetStyle="{Binding Appearance}" Margin="0,0,8,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Content="Decline" Style="{StaticResource Secondary}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Tag="{Binding}" Click="DeclineInvite_Click"/>
                          <Button Content="{Binding AcceptText}" Style="{StaticResource Primary}" Padding="10,3" FontSize="11" Tag="{Binding}" Click="AcceptInvite_Click"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding PeerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel x:Name="FriendsArea" Margin="0,12,0,0">
              <TextBlock Text="Online" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="NoFriendsText" Text="No CydLan users online" FontSize="12" Foreground="{DynamicResource Faint}" Margin="2,2,0,0"/>
              <ItemsControl x:Name="FriendList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,0,6">
                      <DockPanel>
                        <local:FloatingPetVisual DockPanel.Dock="Left" Width="44" Height="40" PetStyle="{Binding Appearance}" Margin="0,0,8,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Content="{Binding TradeActionText}" Style="{StaticResource Secondary}" Padding="10,3" FontSize="11" Margin="0,0,6,0"
                                  Tag="{Binding}" Click="Trade_Click" AutomationProperties.Name="{Binding TradeActionName}"/>
                          <Button Content="{Binding ActionText}" Style="{StaticResource Secondary}" Padding="10,3" FontSize="11"
                                  Tag="{Binding}" Click="Challenge_Click" AutomationProperties.Name="{Binding ActionName}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="TournamentTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="12,10">
                <StackPanel>
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Padding="8,2" CornerRadius="9" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,6,0">
                        <TextBlock x:Name="TourneyTimerText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                      </Border>
                      <Border x:Name="TourneyBadge" Padding="8,2" CornerRadius="9">
                        <TextBlock x:Name="TourneyBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="#1D2326"/>
                      </Border>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock x:Name="TourneySlotText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                      <TextBlock x:Name="TourneyNameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DockPanel>
                  <ItemsControl x:Name="TournamentFights" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border CornerRadius="8" Padding="6,4" Margin="0,0,0,4" BorderThickness="1.5" BorderBrush="{Binding Edge}" Opacity="{Binding Fade}">
                          <DockPanel>
                            <local:FloatingPetVisual DockPanel.Dock="Left" Width="40" Height="36" PetStyle="{Binding Look}" Margin="0,0,8,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button x:Name="TournamentFightButton" Content="Fight" Style="{StaticResource Primary}" Padding="0,9" Click="TournamentBattle_Click" Margin="0,6,0,0"/>
                  <Button x:Name="TournamentDeckNeededButton" Style="{StaticResource Secondary}" Margin="0,6,0,0" Padding="8,5" Click="DeckNeeded_Click" Visibility="Collapsed" BorderBrush="#EF4444" BorderThickness="1">
                    <TextBlock x:Name="TournamentDeckNeededText" Foreground="#EF4444" FontWeight="SemiBold" FontSize="11.5"/>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="PetTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
            <!-- Pet: element, rolled stats and bonus points. -->
            <Border Style="{StaticResource Card}" Padding="0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border CornerRadius="{DynamicResource PanelCorner}" Background="{DynamicResource ChatColorFinishBrush}" Margin="8" MinHeight="160" ClipToBounds="True"
                        Cursor="Hand" MouseLeftButtonDown="MyPet_Click">
                  <local:FloatingPetVisual x:Name="MyPetVisual" Width="160" Height="140" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,12,14,12">
                  <Border x:Name="ElementBadge" HorizontalAlignment="Left" Padding="12,3" CornerRadius="11" AutomationProperties.Name="Element">
                    <TextBlock x:Name="ElementBadgeText" FontSize="13" FontWeight="Bold" Foreground="#1D2326"/>
                  </Border>
                  <TextBlock x:Name="MatchupText" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,5,0,8" TextWrapping="Wrap"/>
                  <DockPanel Margin="0,0,0,4">
                    <Button x:Name="RerollButton" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Padding="8,1" FontSize="11" Click="Reroll_Click" Margin="6,0,0,0" AutomationProperties.Name="Re-roll element and base stats"/>
                    <Button x:Name="ResetPointsButton" DockPanel.Dock="Right" Content="Reset" Style="{StaticResource Secondary}" Padding="8,1" FontSize="11" Click="ResetPoints_Click" AutomationProperties.Name="Reset bonus points"/>
                    <TextBlock x:Name="PointsTitle" Style="{StaticResource SectionTitle}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                  </DockPanel>
                  <ItemsControl x:Name="StatRows">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,4">
                          <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Width="26" Height="22" Padding="0" Content="+" Tag="{Binding Key}"
                                  Click="AddPoint_Click" IsEnabled="{Binding CanAdd}" AutomationProperties.Name="{Binding AddName}"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding BonusText}" Width="30" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" Width="28" TextAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="StatsLine" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,4,0,0" TextWrapping="Wrap"/>
                  <TextBlock x:Name="BoostText" FontSize="11.5" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="2,3,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="DeckTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
            <!-- Deck -->
            <TextBlock x:Name="DeckTitle" Style="{StaticResource SectionTitle}" Margin="2,0,0,6"/>
            <ItemsControl x:Name="DeckList">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource Secondary}" Padding="0" Margin="0,0,6,6" Width="62" Tag="{Binding Id}" Click="DeckCard_Click"
                          MouseRightButtonUp="CardTile_RightClick" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding RemoveName}" BorderBrush="{Binding RarityBrush}" BorderThickness="1.5">
                    <StackPanel Margin="3,4,3,3">
                      <Grid Width="40" Height="40">
                        <Border CornerRadius="8" Background="{Binding KindBrush}" Opacity=".35"/>
                        <Image Source="{Binding Art}" Width="40" Height="40" RenderOptions.BitmapScalingMode="NearestNeighbor">
                          <Image.Clip><RectangleGeometry Rect="0,0,40,40" RadiusX="8" RadiusY="8"/></Image.Clip>
                        </Image>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Accent}" Margin="-4,-4,0,0">
                          <TextBlock Text="{Binding Cost}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Name}" FontSize="9.5" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Collection -->
            <DockPanel Margin="0,12,0,6">
              <ComboBox x:Name="CollectionFilter" DockPanel.Dock="Right" Width="120" SelectionChanged="CollectionFilter_SelectionChanged" AutomationProperties.Name="Collection filter" FontSize="11.5"/>
              <TextBlock x:Name="CollectionTitle" Style="{StaticResource SectionTitle}" VerticalAlignment="Bottom" Margin="2,0,0,0"/>
            </DockPanel>
            <ItemsControl x:Name="CollectionList">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Width="228" Margin="0,0,8,8" Padding="8,6" BorderBrush="{Binding RarityBrush}" BorderThickness="1.5"
                          Tag="{Binding Id}" MouseRightButtonUp="CardTile_RightClick">
                    <DockPanel>
                      <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,8,0" VerticalAlignment="Top">
                        <Border CornerRadius="8" Background="{Binding KindBrush}" Opacity=".35"/>
                        <Image Source="{Binding Art}" Width="40" Height="40" RenderOptions.BitmapScalingMode="NearestNeighbor">
                          <Image.Clip><RectangleGeometry Rect="0,0,40,40" RadiusX="8" RadiusY="8"/></Image.Clip>
                        </Image>
                      </Grid>
                      <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Content="Add" Style="{StaticResource Primary}" Padding="8,2" FontSize="11"
                                Tag="{Binding Id}" Click="AddToDeck_Click" IsEnabled="{Binding CanAdd}" AutomationProperties.Name="{Binding AddName}"/>
                        <Button Content="{Binding SellText}" Style="{StaticResource Secondary}" Padding="6,2" FontSize="10.5" Margin="0,4,0,0"
                                Tag="{Binding Id}" Click="SellCard_Click" IsEnabled="{Binding CanSell}" AutomationProperties.Name="{Binding SellName}"/>
                      </StackPanel>
                      <StackPanel>
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="10.5" Foreground="{DynamicResource Faint}" Margin="4,0,0,0"/>
                          <Border DockPanel.Dock="Left" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Accent}" Margin="0,0,5,0">
                            <TextBlock Text="{Binding Cost}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Text}" FontSize="10.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="ShopTab" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
            <!-- Card raffle -->
            <DockPanel Margin="0,0,0,6">
              <Button x:Name="SpinButton" DockPanel.Dock="Right" Content="Spin · 80" Style="{StaticResource Primary}" Padding="12,3" FontSize="11.5" Click="SpinRaffle_Click" AutomationProperties.Name="Spin card raffle"/>
              <TextBlock Text="Card raffle" Style="{StaticResource SectionTitle}" VerticalAlignment="Bottom" Margin="2,0,0,0"/>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
              <DockPanel>
                <Grid DockPanel.Dock="Left" Width="116" Height="124" Margin="0,0,14,0" VerticalAlignment="Center">
                  <Canvas x:Name="RaffleWheel" Width="116" Height="116" VerticalAlignment="Bottom">
                    <Canvas.RenderTransform>
                      <RotateTransform x:Name="RaffleWheelRotate" Angle="0" CenterX="58" CenterY="58"/>
                    </Canvas.RenderTransform>
                  </Canvas>
                  <Polygon Points="52,0 64,0 58,11" Fill="{DynamicResource Accent}" Stroke="{DynamicResource Surface}" StrokeThickness="1.2" VerticalAlignment="Top"/>
                </Grid>
                <Border x:Name="RaffleResultCard" Style="{StaticResource Card}" Padding="10,8" Visibility="Collapsed" VerticalAlignment="Center" BorderThickness="1.5" MouseRightButtonUp="CardTile_RightClick">
                  <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,10,0">
                      <Border x:Name="RaffleCardBg" CornerRadius="8" Opacity=".35"/>
                      <Image x:Name="RaffleCardArt" Width="44" Height="44" RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Image.Clip><RectangleGeometry Rect="0,0,44,44" RadiusX="8" RadiusY="8"/></Image.Clip>
                      </Image>
                      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="17" Height="17" CornerRadius="8.5" Background="{DynamicResource Accent}" Margin="-4,-4,0,0">
                        <TextBlock x:Name="RaffleCardCost" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="RaffleCardName" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="RaffleCardDetail" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      <TextBlock x:Name="RaffleCardExtra" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,2,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DockPanel>
            </Border>

            <!-- Daily shop -->
            <DockPanel Margin="0,0,0,6">
              <Button x:Name="DailyButton" DockPanel.Dock="Right" Content="Daily bonus" Style="{StaticResource Primary}" Padding="10,3" FontSize="11.5" Click="Daily_Click"/>
              <TextBlock x:Name="ShopTitle" Text="Daily shop" Style="{StaticResource SectionTitle}" VerticalAlignment="Bottom" Margin="2,0,0,0"/>
            </DockPanel>
            <ItemsControl x:Name="ShopList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="8,6" Margin="0,0,0,6" BorderBrush="{Binding RarityBrush}" BorderThickness="1.5"
                          Tag="{Binding CardId}" MouseRightButtonUp="CardTile_RightClick">
                    <DockPanel>
                      <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,8,0">
                        <Border CornerRadius="8" Background="{Binding KindBrush}" Opacity=".35"/>
                        <Image Source="{Binding Art}" Width="40" Height="40" RenderOptions.BitmapScalingMode="NearestNeighbor">
                          <Image.Clip><RectangleGeometry Rect="0,0,40,40" RadiusX="8" RadiusY="8"/></Image.Clip>
                        </Image>
                      </Grid>
                      <Button DockPanel.Dock="Right" Content="{Binding PriceText}" Style="{StaticResource Primary}" Padding="8,3" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                              Tag="{Binding Slot}" Click="BuyCard_Click" IsEnabled="{Binding CanBuy}" AutomationProperties.Name="{Binding BuyName}"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- Battle -->
      <Grid x:Name="BattlePanel" Visibility="Collapsed" SizeChanged="BattlePanel_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="12,9">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="LeftLevel" DockPanel.Dock="Right" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LeftName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <Border Style="{StaticResource Track}" Height="12" Margin="0,6,0,0" x:Name="LeftHpTrack">
                <Grid>
                  <Border x:Name="LeftHpTrail" Style="{StaticResource Fill}" Background="#FFFFFF"/>
                  <Border x:Name="LeftHpFill" Style="{StaticResource Fill}" Background="#22C55E"/>
                </Grid>
              </Border>
              <DockPanel Margin="0,3,0,0">
                <TextBlock x:Name="LeftHpText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Muted}"/>
                <TextBlock x:Name="LeftStatus" FontSize="11" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,0,8,0"/>
              </DockPanel>
              <Border Style="{StaticResource Track}" Height="5" Margin="0,3,0,0" x:Name="LeftChargeTrack">
                <Border x:Name="LeftChargeFill" Style="{StaticResource Fill}" CornerRadius="2" Background="#A855F7"/>
              </Border>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,9">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="RightLevel" DockPanel.Dock="Right" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="RightName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <Border Style="{StaticResource Track}" Height="12" Margin="0,6,0,0" x:Name="RightHpTrack">
                <Grid>
                  <Border x:Name="RightHpTrail" Style="{StaticResource Fill}" Background="#FFFFFF"/>
                  <Border x:Name="RightHpFill" Style="{StaticResource Fill}" Background="#EF4444"/>
                </Grid>
              </Border>
              <DockPanel Margin="0,3,0,0">
                <TextBlock x:Name="RightHpText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Muted}"/>
                <TextBlock x:Name="RightStatus" FontSize="11" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,0,8,0"/>
              </DockPanel>
              <Border Style="{StaticResource Track}" Height="5" Margin="0,3,0,0" x:Name="RightChargeTrack">
                <Border x:Name="RightChargeFill" Style="{StaticResource Fill}" CornerRadius="2" Background="#A855F7"/>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Border x:Name="StageBorder" Grid.Row="1" Margin="0,10,0,10" MinHeight="120" CornerRadius="{DynamicResource PanelCorner}" ClipToBounds="True"
                BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop x:Name="SkyTop" Color="#DCEBFF" Offset="0"/>
              <GradientStop x:Name="SkyBottom" Color="#F4F9FF" Offset=".68"/>
              <GradientStop x:Name="GroundTop" Color="#BFE3B4" Offset=".68"/>
              <GradientStop x:Name="GroundBottom" Color="#9FD196" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
          <Canvas x:Name="Stage" SizeChanged="Stage_SizeChanged">
            <Canvas x:Name="World">
            <Canvas.RenderTransform><ScaleTransform x:Name="WorldScale"/></Canvas.RenderTransform>
            <Canvas x:Name="TerrainLayer" IsHitTestVisible="False"/>
            <local:FloatingPetVisual x:Name="LeftPet" Width="250" Height="224">
              <local:FloatingPetVisual.RenderTransform><TranslateTransform x:Name="LeftMove"/></local:FloatingPetVisual.RenderTransform>
            </local:FloatingPetVisual>
            <local:FloatingPetVisual x:Name="RightPet" Width="250" Height="224">
              <local:FloatingPetVisual.RenderTransform><TranslateTransform x:Name="RightMove"/></local:FloatingPetVisual.RenderTransform>
            </local:FloatingPetVisual>
            <Canvas x:Name="FxLayer" IsHitTestVisible="False"/>
            </Canvas>
            <Border x:Name="ResultCard" Visibility="Collapsed" Style="{StaticResource Card}" Padding="22,16" MinWidth="260">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="ResultTitle" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ResultReason" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock x:Name="ResultReward" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                  <Button x:Name="RematchButton" Content="Rematch" Style="{StaticResource Secondary}" Padding="14,5" Margin="0,0,8,0" Click="Rematch_Click"/>
                  <Button Content="Done" Style="{StaticResource Primary}" Padding="18,5" Click="Done_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Canvas>
          <Border x:Name="QueueTray" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8,8,8,0"
                  CornerRadius="12" Padding="6,5" BorderThickness="1.5" BorderBrush="{DynamicResource Line}"
                  Background="{DynamicResource Surface}" AutomationProperties.Name="Queued cards">
            <StackPanel x:Name="QueuePanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
          </Border>
          </Grid>
        </Border>

        <TextBlock x:Name="LogText" Grid.Row="2" FontSize="12.5" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="2,0,0,8" MinHeight="18"/>

        <DockPanel Grid.Row="3" x:Name="CardBar" Visibility="Collapsed" SizeChanged="HandPanel_SizeChanged">
          <StackPanel x:Name="CardActions" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="8,0,0,0">
            <Button x:Name="FightButton" Content="Fight" Style="{StaticResource Primary}" Padding="22,10" FontSize="13" Click="Fight_Click" Margin="0,0,0,8" AutomationProperties.Name="Play chosen cards"/>
            <Button x:Name="CardLeaveButton" Content="Leave" Style="{StaticResource Secondary}" Padding="12,5" Click="CardLeave_Click" AutomationProperties.Name="Leave battle"/>
          </StackPanel>
          <Border x:Name="EnergyBadge" DockPanel.Dock="Left" Width="58" Height="58" CornerRadius="29" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"
                  AutomationProperties.Name="Energy">
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="EnergyText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center"/>
              <TextBlock Text="energy" FontSize="9.5" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" Margin="0,-3,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel x:Name="HandPanel" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,0"/>
        </DockPanel>

        <DockPanel Grid.Row="3" x:Name="MoveRow">
          <Button x:Name="LeaveButton" DockPanel.Dock="Right" Content="Leave" Style="{StaticResource Secondary}" Padding="12,8" Click="Leave_Click" AutomationProperties.Name="Leave battle"/>
          <TextBlock x:Name="TurnText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <StackPanel x:Name="MoveBar" Orientation="Horizontal">
            <Button x:Name="StrikeButton" Style="{StaticResource MoveButton}" Tag="strike" Click="Move_Click"/>
            <Button x:Name="SpecialButton" Style="{StaticResource MoveButton}" Tag="special" Click="Move_Click"/>
            <Button x:Name="GuardButton" Style="{StaticResource MoveButton}" Tag="guard" Click="Move_Click"/>
            <Button x:Name="HealButton" Style="{StaticResource MoveButton}" Tag="heal" Click="Move_Click"/>
            <Button x:Name="UltimateButton" Style="{StaticResource MoveButton}" Tag="ultimate" Click="Move_Click"/>
          </StackPanel>
        </DockPanel>
        <Canvas x:Name="DragLayer" Grid.RowSpan="4" IsHitTestVisible="False" Panel.ZIndex="200"/>
      </Grid>

      <!-- Card trade -->
      <Grid x:Name="TradePanel" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="12,10">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <local:FloatingPetVisual x:Name="TradeMyPet" DockPanel.Dock="Left" Width="44" Height="40" Margin="0,0,8,0"/>
                <TextBlock x:Name="TradeMyState" DockPanel.Dock="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TradeMyName" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <Border x:Name="TradeMyEmpty" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,14" Background="{DynamicResource Canvas}">
                <TextBlock Text="—" HorizontalAlignment="Center" Foreground="{DynamicResource Faint}"/>
              </Border>
              <Border x:Name="TradeMyCardBox" Style="{StaticResource Card}" Padding="8,6" Visibility="Collapsed" BorderThickness="1.5" MouseRightButtonUp="CardTile_RightClick">
                <DockPanel>
                  <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,8,0">
                    <Border x:Name="TradeMyCardBg" CornerRadius="8" Opacity=".35"/>
                    <Image x:Name="TradeMyCardArt" Width="40" Height="40" RenderOptions.BitmapScalingMode="NearestNeighbor">
                      <Image.Clip><RectangleGeometry Rect="0,0,40,40" RadiusX="8" RadiusY="8"/></Image.Clip>
                    </Image>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Accent}" Margin="-4,-4,0,0">
                      <TextBlock x:Name="TradeMyCardCost" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </Grid>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TradeMyCardName" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TradeMyCardDetail" FontSize="10.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <local:FloatingPetVisual x:Name="TradeTheirPet" DockPanel.Dock="Left" Width="44" Height="40" Margin="0,0,8,0"/>
                <TextBlock x:Name="TradeTheirState" DockPanel.Dock="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TradeTheirName" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <Border x:Name="TradeTheirEmpty" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,14" Background="{DynamicResource Canvas}">
                <TextBlock Text="—" HorizontalAlignment="Center" Foreground="{DynamicResource Faint}"/>
              </Border>
              <Border x:Name="TradeTheirCardBox" Style="{StaticResource Card}" Padding="8,6" Visibility="Collapsed" BorderThickness="1.5" MouseRightButtonUp="CardTile_RightClick">
                <DockPanel>
                  <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,8,0">
                    <Border x:Name="TradeTheirCardBg" CornerRadius="8" Opacity=".35"/>
                    <Image x:Name="TradeTheirCardArt" Width="40" Height="40" RenderOptions.BitmapScalingMode="NearestNeighbor">
                      <Image.Clip><RectangleGeometry Rect="0,0,40,40" RadiusX="8" RadiusY="8"/></Image.Clip>
                    </Image>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Accent}" Margin="-4,-4,0,0">
                      <TextBlock x:Name="TradeTheirCardCost" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </Grid>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TradeTheirCardName" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TradeTheirCardDetail" FontSize="10.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock x:Name="TradeStatusText" Grid.Row="1" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,10,0,0" Visibility="Collapsed"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10">
          <ItemsControl x:Name="TradeCollectionList">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource Secondary}" Width="210" Margin="0,0,8,8" Padding="8,6" BorderBrush="{Binding RarityBrush}" BorderThickness="1.5"
                        Tag="{Binding Id}" Click="TradePick_Click" MouseRightButtonUp="CardTile_RightClick" AutomationProperties.Name="{Binding PickName}">
                  <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,8,0">
                      <Border CornerRadius="8" Background="{Binding KindBrush}" Opacity=".35"/>
                      <Image Source="{Binding Art}" Width="36" Height="36" RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Image.Clip><RectangleGeometry Rect="0,0,36,36" RadiusX="8" RadiusY="8"/></Image.Clip>
                      </Image>
                    </Grid>
                    <StackPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="10.5" Foreground="{DynamicResource Faint}" Margin="4,0,0,0"/>
                        <Border DockPanel.Dock="Left" Width="15" Height="15" CornerRadius="7.5" Background="{DynamicResource Accent}" Margin="0,0,5,0">
                          <TextBlock Text="{Binding Cost}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="TradeCancelButton" Content="Cancel" Style="{StaticResource Secondary}" Padding="14,7" Margin="0,0,8,0" Click="TradeCancel_Click"/>
          <Button x:Name="TradeLockButton" Content="Lock" Style="{StaticResource Primary}" Padding="18,7" Click="TradeLock_Click"/>
        </StackPanel>
      </Grid>
  </Grid>
</UserControl>
