<Window x:Class="CydLan.Desktop.FloatingPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CydLan.Desktop"
        Style="{StaticResource {x:Type Window}}" Title="CydLan Pet"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" Width="240" Height="198">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Bool"/>
  </Window.Resources>
  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="128"/>
    </Grid.RowDefinitions>

    <Border x:Name="SpeechBubble" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="6,0,6,2"
            MaxWidth="220" Padding="10,6" CornerRadius="{DynamicResource PanelCorner}"
            Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.2"
            Visibility="Collapsed" Cursor="Hand" MouseLeftButtonDown="SpeechBubble_Click">
      <StackPanel>
        <TextBlock x:Name="SpeechSender" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="SpeechText" FontSize="11.5" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Grid x:Name="PetHitArea" Grid.Row="1" Width="136" Height="124" HorizontalAlignment="Center" VerticalAlignment="Bottom"
          Margin="0,0,0,4" Cursor="Hand"
          MouseLeftButtonDown="Pet_MouseLeftButtonDown"
          MouseMove="Pet_MouseMove"
          MouseLeftButtonUp="Pet_MouseLeftButtonUp"
          LostMouseCapture="Pet_LostMouseCapture"
          MouseEnter="Pet_MouseEnter"
          MouseLeave="Pet_MouseLeave">
      <Grid.ContextMenu>
        <ContextMenu x:Name="PetContextMenu">
          <MenuItem Header="Quick chat" Click="QuickChat_Click"/>
          <MenuItem x:Name="RoamMenuItem" Header="Roam" IsCheckable="True" Click="Roam_Click"/>
          <MenuItem Header="Customize..." Click="Customize_Click"/>
          <MenuItem Header="Open CydLan" Click="OpenApp_Click"/>
          <Separator/>
          <MenuItem Header="Hide" Click="HidePet_Click"/>
        </ContextMenu>
      </Grid.ContextMenu>
      <Border CornerRadius="36" Background="#01000000"/>
      <local:FloatingPetVisual x:Name="PetVisual" Width="136" Height="124" PetStyle="{Binding PetAppearance}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Border x:Name="UnreadBadge" MinWidth="20" Height="20" Padding="5,0" CornerRadius="10"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,62,24,0"
              Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Canvas}" BorderThickness="1.8"
              Visibility="{Binding HasUnread, Converter={StaticResource Bool}}" IsHitTestVisible="False">
        <TextBlock Text="{Binding TotalUnread}" FontSize="10.5" FontWeight="Bold"
                   Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </Grid>
  </Grid>
</Window>
