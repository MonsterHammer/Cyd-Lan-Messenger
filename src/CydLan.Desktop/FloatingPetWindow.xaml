<Window x:Class="CydLan.Desktop.FloatingPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CydLan.Desktop"
        Style="{StaticResource {x:Type Window}}" Title="CydLan Pet"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" Width="260" Height="300">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Bool"/>
  </Window.Resources>
  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition x:Name="PetRow" Height="128"/>
    </Grid.RowDefinitions>

    <Grid x:Name="PetHitArea" Grid.Row="1" Width="136" Height="124" HorizontalAlignment="Center" VerticalAlignment="Bottom"
          Margin="0,0,0,4" Cursor="Hand"
          MouseLeftButtonDown="Pet_MouseLeftButtonDown"
          MouseMove="Pet_MouseMove"
          MouseLeftButtonUp="Pet_MouseLeftButtonUp"
          LostMouseCapture="Pet_LostMouseCapture"
          MouseEnter="Pet_MouseEnter"
          MouseLeave="Pet_MouseLeave">
      <Grid.ContextMenu>
        <ContextMenu x:Name="PetContextMenu">
          <MenuItem x:Name="MoodMenuItem" IsEnabled="False"/>
          <Separator x:Name="MoodSeparator"/>
          <MenuItem Header="Quick chat" Click="QuickChat_Click"/>
          <MenuItem Header="Reminders" Click="Reminders_Click"/>
          <Separator/>
          <MenuItem Header="Pet" Click="PetPet_Click"/>
          <MenuItem Header="Feed" Click="PetFeed_Click"/>
          <MenuItem Header="Play" Click="PetPlay_Click"/>
          <MenuItem x:Name="SleepMenuItem" Header="Tuck in" Click="PetSleep_Click"/>
          <Separator/>
          <MenuItem x:Name="RoamMenuItem" Header="Roam" IsCheckable="True" Click="Roam_Click"/>
          <MenuItem Header="Customize..." Click="Customize_Click"/>
          <MenuItem Header="Open CydLan" Click="OpenApp_Click"/>
          <Separator/>
          <MenuItem Header="Hide" Click="HidePet_Click"/>
        </ContextMenu>
      </Grid.ContextMenu>
      <Border CornerRadius="36" Background="#01000000"/>
      <local:FloatingPetVisual x:Name="PetVisual" SizeFromBounds="True" PetStyle="{Binding PetAppearance}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      <Border x:Name="UnreadBadge" MinWidth="20" Height="20" Padding="5,0" CornerRadius="10"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,62,24,0"
              Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Canvas}" BorderThickness="1.8"
              Visibility="{Binding HasUnread, Converter={StaticResource Bool}}" IsHitTestVisible="False">
        <TextBlock Text="{Binding TotalUnread}" FontSize="10.5" FontWeight="Bold"
                   Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </Grid>

    <!-- Bubbles come after the pet so they stay on top where they dip into its empty headroom. -->
    <Border x:Name="SpeechBubble" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="6,0,6,-36"
            MaxWidth="220" Padding="10,6" CornerRadius="{DynamicResource PanelCorner}"
            Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.2"
            Visibility="Collapsed" Cursor="Hand" MouseLeftButtonDown="SpeechBubble_Click">
      <StackPanel>
        <TextBlock x:Name="SpeechSender" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="SpeechText" FontSize="11.5" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Border x:Name="ReminderBubble" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="4,0,4,-36"
            Width="236" Padding="11,9,11,10" CornerRadius="{DynamicResource PanelCorner}"
            Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.6"
            Visibility="Collapsed" RenderTransformOrigin=".5,1" AutomationProperties.Name="Reminder"
            AutomationProperties.LiveSetting="Assertive">
      <Border.RenderTransform><TranslateTransform x:Name="ReminderShake"/></Border.RenderTransform>
      <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity=".22"/></Border.Effect>
      <StackPanel>
        <DockPanel>
          <Border x:Name="ReminderIconDisc" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentSoft}" Margin="0,0,8,0" VerticalAlignment="Top">
            <local:Glyph x:Name="ReminderGlyph" Size="13" Foreground="{DynamicResource Accent}"/>
          </Border>
          <Border x:Name="ReminderQueueBadge" DockPanel.Dock="Right" MinWidth="20" Height="18" Padding="5,0" CornerRadius="9" Margin="6,0,0,0"
                  Background="{DynamicResource Accent}" VerticalAlignment="Top" Visibility="Collapsed">
            <TextBlock x:Name="ReminderQueueText" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock x:Name="ReminderTitleText" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ReminderWhenText" FontSize="10.5" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
        <TextBlock x:Name="ReminderLineText" FontSize="12" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="48" Margin="0,7,0,0"/>
        <TextBlock x:Name="ReminderNoteText" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
        <Grid Margin="0,9,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="ReminderMoreButton" Style="{StaticResource Icon}" Width="26" Height="26" Click="ReminderMore_Click" ToolTip="More" AutomationProperties.Name="More reminder options">
            <local:Glyph Data="{DynamicResource IconMore}" Size="14" StrokeThickness="2.4"/>
            <Button.ContextMenu>
              <ContextMenu x:Name="ReminderMoreMenu">
                <MenuItem Header="Snooze 5 minutes" Tag="5" Click="ReminderSnoozeFor_Click"/>
                <MenuItem Header="Snooze 30 minutes" Tag="30" Click="ReminderSnoozeFor_Click"/>
                <MenuItem Header="Snooze 1 hour" Tag="60" Click="ReminderSnoozeFor_Click"/>
                <MenuItem Header="Skip today" Click="ReminderSkip_Click"/>
                <Separator/>
                <MenuItem Header="Open reminders" Click="ReminderOpen_Click"/>
                <MenuItem Header="Hide" Click="ReminderDismiss_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button x:Name="ReminderSnoozeButton" Content="Snooze" Style="{StaticResource Secondary}" Padding="10,4" Margin="0,0,6,0" Click="ReminderSnooze_Click" AutomationProperties.Name="Snooze reminder 10 minutes"/>
            <Button x:Name="ReminderDoneButton" Content="Done" Style="{StaticResource Primary}" Padding="14,4" Click="ReminderDone_Click" AutomationProperties.Name="Mark reminder done"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

  </Grid>
</Window>
