<Window x:Class="CydLan.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CydLan settings" Width="530" Height="690" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#FCFCFE">
  <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Make yourself at home." FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Your profile and local workspace preferences." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,9,0,28"/><TextBlock Text="Display name" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="DisplayNameBox" MaxLength="80"/><TextBlock Text="Availability" FontSize="12" Margin="0,20,0,8"/><ComboBox x:Name="StatusBox" Padding="10,8"><ComboBoxItem Content="Available" Tag="chat"/><ComboBoxItem Content="Away" Tag="away"/><ComboBoxItem Content="Busy" Tag="busy"/><ComboBoxItem Content="Do not disturb" Tag="dnd"/></ComboBox><CheckBox x:Name="NotificationsBox" Content="Show tray notifications for new messages" Margin="0,24,0,16"/><CheckBox x:Name="MinimizedBox" Content="Start in the system tray when launched"/><Border Background="#F0ECFA" CornerRadius="10" Padding="16" Margin="0,26,0,23"><StackPanel><TextBlock Text="Always local. Always direct." FontWeight="SemiBold" FontSize="13" Foreground="#8870B8"/><TextBlock Text="Close the window to keep CydLan in your tray. Use the tray menu to quit. No account or dedicated server is required." TextWrapping="Wrap" FontSize="12" Foreground="#9990AE" LineHeight="21" Margin="0,9,0,0"/></StackPanel></Border><TextBlock Text="DESIGN WORKSPACE" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock Text="{Binding LocalAddress, StringFormat=Your device: {0}}" FontSize="12" Margin="0,12,0,6"/><TextBlock Text="Networking is disabled in this design build." FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="Sample contacts and conversations stay in memory. Explore the interface without connecting to other computers." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" LineHeight="20" Margin="0,9,0,12"/><ItemsControl ItemsSource="{Binding Diagnostics}" FontSize="10" Foreground="{StaticResource Muted}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0"/><Button Content="Save preferences" Style="{StaticResource Primary}" Click="Save_Click"/></StackPanel></Grid>
</Window>
