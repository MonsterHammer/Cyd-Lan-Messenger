<Window x:Class="CydLan.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:CydLan.Desktop"
        Style="{StaticResource {x:Type Window}}" Title="CydLan preferences" Width="680" Height="520" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Seg" Background="Transparent" CornerRadius="6" Padding="0,7"><ContentPresenter HorizontalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Seg" Property="Background" Value="{DynamicResource Canvas}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style x:Key="Page" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Margin" Value="0,0,8,12"/></Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,0,0,12"/></Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- Pages follow LAN Messenger's preferences: General, Account, Messages, History, Alerts, Network, Files, Appearance. -->
      <Border Background="{DynamicResource Sidebar}">
        <StackPanel x:Name="NavPanel" Margin="8,0">
          <Grid x:Name="TitleBar" Background="Transparent" Height="56"><TextBlock Text="Preferences" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
          <RadioButton Style="{StaticResource FilterRow}" Content="General" Tag="GeneralPage" Checked="Page_Checked" IsChecked="True"/>
          <RadioButton Style="{StaticResource FilterRow}" Content="Account" Tag="AccountPage" Checked="Page_Checked"/>
          <RadioButton Style="{StaticResource FilterRow}" Content="Messages" Tag="MessagesPage" Checked="Page_Checked"/>
          <RadioButton Style="{StaticResource FilterRow}" Content="History" Tag="HistoryPage" Checked="Page_Checked"/>
          <RadioButton Style="{StaticResource FilterRow}" Content="Alerts" Tag="AlertsPage" Checked="Page_Checked"/>
          <RadioButton Style="{StaticResource FilterRow}" Content="Network" Tag="NetworkPage" Checked="Page_Checked"/>
          <RadioButton Style="{StaticResource FilterRow}" Content="Files" Tag="FilesPage" Checked="Page_Checked"/>
          <RadioButton Style="{StaticResource FilterRow}" Content="Appearance" Tag="AppearancePage" Checked="Page_Checked"/>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="24,0,20,16">
        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
        <Grid x:Name="DragArea" Background="Transparent">
          <Button Style="{StaticResource Icon}" Width="30" Height="30" HorizontalAlignment="Right" ToolTip="Close" Click="Cancel_Click"><local:Glyph Data="{StaticResource IconClose}" Size="16"/></Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <Grid>
            <StackPanel x:Name="GeneralPage" Style="{StaticResource Page}" Visibility="Visible">
              <TextBlock Text="General" Style="{StaticResource Heading}"/>
              <CheckBox x:Name="StartWithWindowsBox" Content="Start CydLan when Windows starts"/>
              <CheckBox x:Name="MinimizedBox" Content="Start in the tray"/>
              <TextBlock Text="Availability" Style="{StaticResource Label}" Margin="0,8,0,6"/>
              <ComboBox x:Name="StatusBox"><ComboBoxItem Content="Available" Tag="chat"/><ComboBoxItem Content="Away" Tag="away"/><ComboBoxItem Content="Busy" Tag="busy"/><ComboBoxItem Content="Do not disturb" Tag="dnd"/></ComboBox>
            </StackPanel>

            <StackPanel x:Name="AccountPage" Style="{StaticResource Page}">
              <TextBlock Text="Account" Style="{StaticResource Heading}"/>
              <TextBlock Text="Profile picture" Style="{StaticResource Label}"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Grid Width="56" Height="56">
                  <Border CornerRadius="28" Background="{DynamicResource Avatar}"><TextBlock x:Name="AvatarInitial" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <Image x:Name="AvatarPreview" Stretch="UniformToFill" local:Rounded.Radius="28" AutomationProperties.Name="Profile picture"/>
                </Grid>
                <Button Content="Choose" Style="{StaticResource Secondary}" Margin="14,0,0,0" VerticalAlignment="Center" Click="ChooseAvatar_Click" AutomationProperties.Name="Choose profile picture"/>
                <Button x:Name="RemoveAvatarButton" Content="Remove" Style="{StaticResource Secondary}" Margin="8,0,0,0" VerticalAlignment="Center" Click="RemoveAvatar_Click" AutomationProperties.Name="Remove profile picture"/>
              </StackPanel>
              <TextBlock Text="Name seen by contacts" Style="{StaticResource Label}"/>
              <TextBox x:Name="DisplayNameBox" MaxLength="80" AutomationProperties.Name="Display name"/>
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="First name" Style="{StaticResource Label}"/><TextBox x:Name="FirstNameBox" MaxLength="80" AutomationProperties.Name="First name"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Last name" Style="{StaticResource Label}"/><TextBox x:Name="LastNameBox" MaxLength="80" AutomationProperties.Name="Last name"/></StackPanel>
              </Grid>
              <TextBlock Text="About" Style="{StaticResource Label}" Margin="0,14,0,6"/>
              <TextBox x:Name="AboutBox" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="120" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="About"/>
            </StackPanel>

            <StackPanel x:Name="MessagesPage" Style="{StaticResource Page}">
              <TextBlock Text="Messages" Style="{StaticResource Heading}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Font" Style="{StaticResource Label}"/><ComboBox x:Name="FontBox" MaxDropDownHeight="260" SelectionChanged="Font_Changed" AutomationProperties.Name="Message font"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Size" Style="{StaticResource Label}"/><ComboBox x:Name="SizeBox" SelectionChanged="Font_Changed" AutomationProperties.Name="Message text size"><ComboBoxItem Content="Small" Tag="small"/><ComboBoxItem Content="Medium" Tag="medium"/><ComboBoxItem Content="Large" Tag="large"/></ComboBox></StackPanel>
              </Grid>
              <Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="14,10" Margin="0,12,0,18" HorizontalAlignment="Left">
                <TextBlock x:Name="FontPreview" Text="The quick brown fox jumps over the lazy dog."/>
              </Border>
              <TextBlock Text="Send with" Style="{StaticResource Label}"/>
              <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="3" Margin="0,0,0,16" Width="260" HorizontalAlignment="Left">
                <UniformGrid Columns="2">
                  <RadioButton x:Name="SendEnter" Content="Enter" GroupName="SendKey" Style="{StaticResource Segment}"/>
                  <RadioButton x:Name="SendCtrlEnter" Content="Ctrl + Enter" GroupName="SendKey" Style="{StaticResource Segment}"/>
                </UniformGrid>
              </Border>
              <CheckBox x:Name="TrimBox" Content="Remove spaces at the start and end of messages"/>
            </StackPanel>

            <StackPanel x:Name="HistoryPage" Style="{StaticResource Page}">
              <TextBlock Text="History" Style="{StaticResource Heading}"/>
              <CheckBox x:Name="KeepHistoryBox" Content="Keep conversation history"/>
              <Button Content="Clear conversation history" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,0,0,22" Click="ClearHistory_Click"/>
              <CheckBox x:Name="KeepFileHistoryBox" Content="Keep file transfer history"/>
              <Button Content="Clear file history" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Click="ClearFiles_Click"/>
            </StackPanel>

            <StackPanel x:Name="AlertsPage" Style="{StaticResource Page}">
              <TextBlock Text="Alerts" Style="{StaticResource Heading}"/>
              <CheckBox x:Name="NotificationsBox" Content="Show notifications"/>
              <CheckBox x:Name="AlertsBusyBox" Content="…also when I'm Busy" Margin="24,0,0,12"/>
              <CheckBox x:Name="AlertsDndBox" Content="…also when I'm on Do not disturb" Margin="24,0,0,20"/>
              <CheckBox x:Name="SoundsBox" Content="Play sounds"/>
              <CheckBox x:Name="SoundsBusyBox" Content="…also when I'm Busy" Margin="24,0,0,12"/>
              <CheckBox x:Name="SoundsDndBox" Content="…also when I'm on Do not disturb" Margin="24,0,0,12"/>
            </StackPanel>

            <StackPanel x:Name="NetworkPage" Style="{StaticResource Page}">
              <TextBlock Text="Network" Style="{StaticResource Heading}"/>
              <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="{Binding ConnectionSummary}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                  <TextBlock Text="{Binding NetworkEndpoint}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,12"/>
                  <TextBlock Text="Connect by IP" Style="{StaticResource Label}"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="AddressBox" AutomationProperties.Name="IP address" MaxLength="64"/>
                    <Button Grid.Column="1" Content="Connect" Style="{StaticResource Primary}" Click="Connect_Click" Margin="8,0,0,0"/>
                  </Grid>
                  <TextBlock Text="{Binding Toast}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Port" Style="{StaticResource Label}"/><TextBox x:Name="PortBox" MaxLength="5" AutomationProperties.Name="Port"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Multicast address" Style="{StaticResource Label}"/><TextBox x:Name="MulticastBox" MaxLength="15" AutomationProperties.Name="Multicast address"/></StackPanel>
              </Grid>
              <TextBlock Text="Port and multicast changes apply after restarting CydLan." FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,8,0,14" TextWrapping="Wrap"/>
              <Button Content="Open logs" Click="OpenLogs_Click" IsEnabled="{Binding HasLogs}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
              <Expander Header="Diagnostics" Foreground="{DynamicResource Muted}">
                <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,7"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </Expander>
            </StackPanel>

            <StackPanel x:Name="FilesPage" Style="{StaticResource Page}">
              <TextBlock Text="Files" Style="{StaticResource Heading}"/>
              <TextBlock Text="Save received files to" Style="{StaticResource Label}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" IsReadOnly="True" AutomationProperties.Name="Received files folder"/>
                <Button Grid.Column="1" Content="Change" Style="{StaticResource Secondary}" Margin="8,0,0,0" Click="ChangeFolder_Click"/>
                <Button Grid.Column="2" Content="Open" Style="{StaticResource Secondary}" Margin="8,0,0,0" Click="OpenFolder_Click"/>
              </Grid>
              <CheckBox x:Name="AutoAcceptBox" Content="Accept files automatically" Margin="0,18,0,6"/>
              <TextBlock Text="Files are saved without asking. Programs are never opened automatically." FontSize="12" Foreground="{DynamicResource Faint}" TextWrapping="Wrap" Margin="24,0,0,0"/>
            </StackPanel>

            <StackPanel x:Name="AppearancePage" Style="{StaticResource Page}">
              <TextBlock Text="Appearance" Style="{StaticResource Heading}"/>
              <TextBlock Text="Theme" Style="{StaticResource Label}"/>
              <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="3">
                <UniformGrid Columns="3">
                  <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked" Tag="light"/>
                  <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked" Tag="dark"/>
                  <RadioButton x:Name="ThemeSystem" Content="Match Windows" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked" Tag="system"/>
                </UniformGrid>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <Button Content="Cancel" Style="{StaticResource Secondary}" Click="Cancel_Click" Margin="0,0,8,0"/>
          <Button Content="Save" Style="{StaticResource Primary}" Click="Save_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
