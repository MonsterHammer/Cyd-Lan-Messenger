                        </RadioButton>
                        <RadioButton x:Name="BgAnchorLeft" Tag="left" Style="{StaticResource AnchorCell}" GroupName="BgAnchor"
                                     Checked="BackgroundAnchor_Checked" AutomationProperties.Name="Left">
                          <local:Glyph Data="M18,12 H6 M11,7 L6,12 L11,17" Size="11" StrokeThickness="1.8"/>
                        </RadioButton>
                        <RadioButton x:Name="BgAnchorCenter" Tag="center" Style="{StaticResource AnchorCell}" GroupName="BgAnchor"
                                     Checked="BackgroundAnchor_Checked" AutomationProperties.Name="Center">
                          <local:Glyph Data="M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z" Size="11" StrokeThickness="2.0"/>
                        </RadioButton>
                        <RadioButton x:Name="BgAnchorRight" Tag="right" Style="{StaticResource AnchorCell}" GroupName="BgAnchor"
                                     Checked="BackgroundAnchor_Checked" AutomationProperties.Name="Right">
                          <local:Glyph Data="M6,12 H18 M13,7 L18,12 L13,17" Size="11" StrokeThickness="1.8"/>
                        </RadioButton>
                        <RadioButton x:Name="BgAnchorBottomLeft" Tag="bottom-left" Style="{StaticResource AnchorCell}" GroupName="BgAnchor"
                                     Checked="BackgroundAnchor_Checked" AutomationProperties.Name="Bottom left">
                          <local:Glyph Data="M17,7 L7,17 M7,10 V17 H14" Size="11" StrokeThickness="1.8"/>
                        </RadioButton>
                        <RadioButton x:Name="BgAnchorBottom" Tag="bottom" Style="{StaticResource AnchorCell}" GroupName="BgAnchor"
                                     Checked="BackgroundAnchor_Checked" AutomationProperties.Name="Bottom">
                          <local:Glyph Data="M12,6 V18 M7,13 L12,18 L17,13" Size="11" StrokeThickness="1.8"/>
                        </RadioButton>
                        <RadioButton x:Name="BgAnchorBottomRight" Tag="bottom-right" Style="{StaticResource AnchorCell}" GroupName="BgAnchor"
                                     Checked="BackgroundAnchor_Checked" AutomationProperties.Name="Bottom right">
                          <local:Glyph Data="M7,7 L17,17 M17,10 V17 H10" Size="11" StrokeThickness="1.8"/>
                        </RadioButton>
                      </UniformGrid>
                    </Border>
                    <CheckBox x:Name="BackgroundGrayscaleBox" Content="Grayscale" VerticalAlignment="Center" Margin="18,0,0,0"
                              Checked="BackgroundGrayscale_Changed" Unchecked="BackgroundGrayscale_Changed"/>
                  </StackPanel>
                  <TextBlock Text="Side transitions" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                  <ListBox x:Name="BackgroundTransitionBox" Style="{StaticResource SwatchGrid}" SelectedValuePath="Value"
                           SelectionChanged="BackgroundTransition_Changed"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           Margin="0,0,0,6" AutomationProperties.Name="Background side transitions">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Margin" Value="0,0,8,8"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name, Mode=OneTime}"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="Frame" Width="116" Height="56" CornerRadius="{DynamicResource ControlCorner}"
                                      BorderBrush="{DynamicResource Line}" BorderThickness="1.5" Background="{DynamicResource Canvas}"
                                      local:Rounded.Radius="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource Self}}" ClipToBounds="True">
                                <Grid>
                                  <ContentPresenter/>
                                  <Border x:Name="SelectedBadge" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Accent}"
                                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Visibility="Collapsed">
                                    <local:Glyph Data="{DynamicResource IconCheck}" Size="9" StrokeThickness="2.2" Foreground="{DynamicResource AccentInk}"/>
                                  </Border>
                                </Grid>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                  <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                                  <Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:BackgroundTransitionSwatch}">
                        <Grid>
                          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="21"/></Grid.RowDefinitions>
                          <local:BackgroundTransitionPreview Kind="{Binding Kind, Mode=OneTime}"/>
                          <Border Grid.Row="1" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="7,0">
                            <TextBlock Text="{Binding Name, Mode=OneTime}" Foreground="{DynamicResource Ink}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel Margin="0,2,0,10">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SelectedValue, ElementName=BackgroundTransitionBox}" Value="off"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                          <DataTrigger Binding="{Binding SelectedValue, ElementName=BackgroundTransitionBox}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=BackgroundTransitionStrengthBox, StringFormat=P0}" Foreground="{DynamicResource Muted}"/>
                      <TextBlock Text="Transition softness" Style="{StaticResource Label}" Margin="0"/>
                    </DockPanel>
                    <Slider x:Name="BackgroundTransitionStrengthBox" Style="{StaticResource BackgroundSlider}" Minimum=".1" Maximum="1" TickFrequency=".05"
                            SmallChange=".05" LargeChange=".10" IsSnapToTickEnabled="True" ValueChanged="BackgroundTransition_SliderChanged"
                            AutomationProperties.Name="Background transition softness"/>
                  </StackPanel>
                  <Border Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                          CornerRadius="{DynamicResource PanelCorner}" Height="142" ClipToBounds="True">
                    <Grid x:Name="BackgroundPreviewHorizontalMask">
                      <Grid x:Name="BackgroundPreviewVerticalMask">
                        <local:BackgroundImageViewport x:Name="BackgroundPreviewViewport">
                          <Image x:Name="BackgroundPreview" Stretch="Fill" Opacity="{Binding Value, ElementName=BackgroundOpacityBox}"
                                 RenderOptions.BitmapScalingMode="HighQuality"
                                 AutomationProperties.Name="Chat background preview"/>
                        </local:BackgroundImageViewport>
                        <Border x:Name="BackgroundPreviewDimOverlay" Background="{DynamicResource Canvas}" Opacity="{Binding Value, ElementName=BackgroundDimBox}" IsHitTestVisible="False"/>
                      </Grid>
                    </Grid>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="BackgroundError" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="AboutPage" Style="{StaticResource Page}">
              <TextBlock Text="About" Style="{StaticResource Heading}"/>
              <Image Source="{DynamicResource BrandMark}" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,12"/>
              <TextBlock Text="Cyd Lan Messenger" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="VersionText" Margin="0,6,0,16"/>
              <TextBlock Text="Developer" Style="{StaticResource Label}"/>
              <TextBlock Text="MonsterHammer" Margin="0,0,0,12"/>
              <TextBlock Text="GPL-3.0-or-later" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <Button Content="Cancel" Style="{StaticResource Secondary}" Click="Cancel_Click" Margin="0,0,8,0"/>
          <Button Content="Save" AutomationProperties.Name="Save" Style="{StaticResource Primary}" Click="Save_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
