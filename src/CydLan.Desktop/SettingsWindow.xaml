                      <local:SidebarEffect x:Name="SidebarMotesPreview" Kind="Motes" Intensity="{Binding Value, ElementName=SidebarMotesIntensityBox}"/>
                    </Border>
                  </CheckBox>
                  <CheckBox x:Name="SidebarGlowBox" Style="{StaticResource EffectCard}" Tag="Edge glow" AutomationProperties.Name="Edge glow">
                    <Border Background="{DynamicResource Sidebar}">
                      <local:SidebarEffect x:Name="SidebarGlowPreview" Kind="EdgeGlow" Intensity="{Binding Value, ElementName=SidebarGlowIntensityBox}"/>
                    </Border>
                  </CheckBox>
                  <CheckBox x:Name="SidebarPrismBox" Style="{StaticResource EffectCard}" Tag="Prism wash" AutomationProperties.Name="Prism wash">
                    <Border Background="{DynamicResource Sidebar}">
                      <local:SidebarEffect x:Name="SidebarPrismPreview" Kind="Prism" Intensity="{Binding Value, ElementName=SidebarPrismIntensityBox}"/>
                    </Border>
                  </CheckBox>
                  <CheckBox x:Name="SidebarSweepBox" Style="{StaticResource EffectCard}" Tag="Radar sweep" AutomationProperties.Name="Radar sweep">
                    <Border Background="{DynamicResource Sidebar}">
                      <local:SidebarEffect x:Name="SidebarSweepPreview" Kind="Sweep" Intensity="{Binding Value, ElementName=SidebarSweepIntensityBox}"/>
                    </Border>
                  </CheckBox>
                </WrapPanel>
                <StackPanel Visibility="{Binding IsChecked, ElementName=SidebarMotesBox, Converter={StaticResource Bool}}">
                  <DockPanel Margin="0,4,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=SidebarMotesIntensityBox, StringFormat=P0}" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="Motes intensity" Style="{StaticResource Label}" Margin="0"/>
                  </DockPanel>
                  <Slider x:Name="SidebarMotesIntensityBox" Style="{StaticResource BackgroundSlider}" Minimum=".1" Maximum="1" TickFrequency=".05"
                          SmallChange=".05" LargeChange=".10" IsSnapToTickEnabled="True" AutomationProperties.Name="Floating motes intensity" Margin="0,0,0,8"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsChecked, ElementName=SidebarGlowBox, Converter={StaticResource Bool}}">
                  <DockPanel Margin="0,4,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=SidebarGlowIntensityBox, StringFormat=P0}" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="Glow intensity" Style="{StaticResource Label}" Margin="0"/>
                  </DockPanel>
                  <Slider x:Name="SidebarGlowIntensityBox" Style="{StaticResource BackgroundSlider}" Minimum=".1" Maximum="1" TickFrequency=".05"
                          SmallChange=".05" LargeChange=".10" IsSnapToTickEnabled="True" AutomationProperties.Name="Edge glow intensity" Margin="0,0,0,8"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsChecked, ElementName=SidebarPrismBox, Converter={StaticResource Bool}}">
                  <DockPanel Margin="0,4,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=SidebarPrismIntensityBox, StringFormat=P0}" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="Prism intensity" Style="{StaticResource Label}" Margin="0"/>
                  </DockPanel>
                  <Slider x:Name="SidebarPrismIntensityBox" Style="{StaticResource BackgroundSlider}" Minimum=".1" Maximum="1" TickFrequency=".05"
                          SmallChange=".05" LargeChange=".10" IsSnapToTickEnabled="True" AutomationProperties.Name="Prism wash intensity" Margin="0,0,0,8"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsChecked, ElementName=SidebarSweepBox, Converter={StaticResource Bool}}">
                  <DockPanel Margin="0,4,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=SidebarSweepIntensityBox, StringFormat=P0}" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="Sweep intensity" Style="{StaticResource Label}" Margin="0"/>
                  </DockPanel>
                  <Slider x:Name="SidebarSweepIntensityBox" Style="{StaticResource BackgroundSlider}" Minimum=".1" Maximum="1" TickFrequency=".05"
                          SmallChange=".05" LargeChange=".10" IsSnapToTickEnabled="True" AutomationProperties.Name="Radar sweep intensity" Margin="0,0,0,8"/>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="AppearanceAuraSection" Visibility="Collapsed">
                <TextBlock Text="Selection &amp; button aura" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                <ListBox x:Name="TargetAuraBox" Style="{StaticResource SwatchGrid}" SelectedValuePath="Value" SelectionChanged="TargetAura_Changed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Margin="0,0,0,6" AutomationProperties.Name="Selection and button aura">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                      <Setter Property="Margin" Value="0,0,8,8"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Cursor" Value="Hand"/>
                      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Frame" Width="126" Height="64" CornerRadius="{DynamicResource ControlCorner}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1.5" Background="{DynamicResource Sidebar}"
                                    local:Rounded.Radius="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource Self}}" ClipToBounds="True">
                              <Grid>
                                <ContentPresenter/>
                                <Border x:Name="SelectedBadge" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Accent}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Visibility="Collapsed">
                                  <local:Glyph Data="{DynamicResource IconCheck}" Size="9" StrokeThickness="2.2" Foreground="{DynamicResource AccentInk}"/>
                                </Border>
                              </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TargetAuraSwatch}">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="21"/></Grid.RowDefinitions>
                        <Grid ClipToBounds="True">
                          <Border Margin="22,9" CornerRadius="6" Background="{DynamicResource NavSelected}" BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
                          <local:TargetAura Kind="{Binding Kind}" Intensity=".85"/>
                          <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="7,0">
                          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Margin="0,2,0,8">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedValue, ElementName=TargetAuraBox}" Value="off">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedValue, ElementName=TargetAuraBox}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <WrapPanel Margin="0,4,0,8">
                    <CheckBox x:Name="AuraModuleBox" Content="Selected module" Margin="0,0,14,4" Checked="TargetAuraTarget_Changed" Unchecked="TargetAuraTarget_Changed"/>
                    <CheckBox x:Name="AuraPersonBox" Content="Selected person" Margin="0,0,14,4" Checked="TargetAuraTarget_Changed" Unchecked="TargetAuraTarget_Changed"/>
                    <CheckBox x:Name="AuraButtonsBox" Content="Highlight buttons" Margin="0,0,0,4" Checked="TargetAuraTarget_Changed" Unchecked="TargetAuraTarget_Changed"/>
                  </WrapPanel>
                  <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=TargetAuraIntensityBox, StringFormat=P0}" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="Aura intensity" Style="{StaticResource Label}" Margin="0"/>
                  </DockPanel>
                  <Slider x:Name="TargetAuraIntensityBox" Style="{StaticResource BackgroundSlider}" Minimum=".1" Maximum="1" TickFrequency=".05"
                          SmallChange=".05" LargeChange=".10" IsSnapToTickEnabled="True" ValueChanged="TargetAura_SliderChanged"
                          AutomationProperties.Name="Aura intensity" Margin="0,0,0,8"/>
                  <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                          CornerRadius="{DynamicResource PanelCorner}" Padding="12,12" Margin="0,2,0,0" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="AuraPreviewModule" Style="{StaticResource NavIcon}" Background="{DynamicResource NavSelected}" Foreground="{DynamicResource Accent}" Margin="0,0,12,0" local:ButtonEffects.IsHighlight="True" local:TargetAura.Role="Module" AutomationProperties.Name="Preview module aura">
                        <local:Glyph Data="{DynamicResource IconChat}" Size="19"/>
                      </Button>
                      <Grid Width="136" Height="38" Margin="0,0,12,0">
                        <Border CornerRadius="{DynamicResource ControlCorner}" Background="{DynamicResource RowSelected}" ClipToBounds="True">
                          <Grid>
                            <local:TargetAura x:Name="TargetAuraPreviewPerson"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                              <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Avatar}" Margin="0,0,8,0">
                                <TextBlock Text="JC" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <TextBlock Text="Jamie Chen" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                        <Border Width="3" Height="16" CornerRadius="{DynamicResource MarkerCorner}" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-1,0,0,0"/>
                      </Grid>
                      <Button x:Name="AuraPreviewButton" Content="Highlight" Style="{StaticResource Primary}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <Separator Margin="0,4,0,12" Background="{DynamicResource Line}"/>
                <TextBlock Text="Highlight buttons" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,4">
                  <CheckBox x:Name="ButtonGlowBox" Style="{StaticResource EffectCard}" Tag="Glow halo" Checked="ButtonEffect_Changed" Unchecked="ButtonEffect_Changed" AutomationProperties.Name="Glow halo">
                    <Grid Background="{DynamicResource Canvas}">
                      <Border x:Name="GlowPreviewPill" Width="64" Height="22" CornerRadius="6" Background="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Effect><DropShadowEffect Color="{Binding Background.Color, ElementName=GlowPreviewPill}" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/></Border.Effect>
                      </Border>
                    </Grid>
                  </CheckBox>
                  <CheckBox x:Name="ButtonSheenBox" Style="{StaticResource EffectCard}" Tag="Sheen sweep" Checked="ButtonEffect_Changed" Unchecked="ButtonEffect_Changed" AutomationProperties.Name="Sheen sweep">
                    <Grid Background="{DynamicResource Canvas}">
                      <Border Width="64" Height="22" CornerRadius="6" Background="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                        <Border CornerRadius="6">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.4">
                              <GradientStop Color="#00FFFFFF" Offset="0.25"/>
                              <GradientStop Color="#B8FFFFFF" Offset="0.5"/>
                              <GradientStop Color="#00FFFFFF" Offset="0.75"/>
                            </LinearGradientBrush>
                          </Border.Background>
                        </Border>
                      </Border>
                    </Grid>
                  </CheckBox>
                  <CheckBox x:Name="ButtonBounceBox" Style="{StaticResource EffectCard}" Tag="Hover bounce" Checked="ButtonEffect_Changed" Unchecked="ButtonEffect_Changed" AutomationProperties.Name="Hover bounce">
                    <Grid Background="{DynamicResource Canvas}">
                      <Border Width="68" Height="25" CornerRadius="7" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Border Width="60" Height="20" CornerRadius="6" Background="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                  </CheckBox>
                  <CheckBox x:Name="ButtonRingBox" Style="{StaticResource EffectCard}" Tag="Accent ring" Checked="ButtonEffect_Changed" Unchecked="ButtonEffect_Changed" AutomationProperties.Name="Accent ring">
                    <Grid Background="{DynamicResource Canvas}">
                      <Border Width="66" Height="24" CornerRadius="7" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                  </CheckBox>
                </WrapPanel>
                <StackPanel Visibility="{Binding IsChecked, ElementName=ButtonGlowBox, Converter={StaticResource Bool}}">
                  <DockPanel Margin="0,4,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=ButtonGlowIntensityBox, StringFormat=P0}" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="Glow intensity" Style="{StaticResource Label}" Margin="0"/>
                  </DockPanel>
                  <Slider x:Name="ButtonGlowIntensityBox" Style="{StaticResource BackgroundSlider}" Minimum=".1" Maximum="1" TickFrequency=".05"
                          SmallChange=".05" LargeChange=".10" IsSnapToTickEnabled="True" ValueChanged="ButtonEffect_SliderChanged"
                          AutomationProperties.Name="Glow halo intensity" Margin="0,0,0,8"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsChecked, ElementName=ButtonSheenBox, Converter={StaticResource Bool}}">
                  <DockPanel Margin="0,4,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=ButtonSheenIntensityBox, StringFormat=P0}" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="Sheen intensity" Style="{StaticResource Label}" Margin="0"/>
                  </DockPanel>
                  <Slider x:Name="ButtonSheenIntensityBox" Style="{StaticResource BackgroundSlider}" Minimum=".1" Maximum="1" TickFrequency=".05"
                          SmallChange=".05" LargeChange=".10" IsSnapToTickEnabled="True" ValueChanged="ButtonEffect_SliderChanged"
                          AutomationProperties.Name="Sheen sweep intensity" Margin="0,0,0,8"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsChecked, ElementName=ButtonBounceBox, Converter={StaticResource Bool}}">
                  <DockPanel Margin="0,4,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=ButtonBounceIntensityBox, StringFormat=P0}" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="Bounce intensity" Style="{StaticResource Label}" Margin="0"/>
                  </DockPanel>
                  <Slider x:Name="ButtonBounceIntensityBox" Style="{StaticResource BackgroundSlider}" Minimum=".1" Maximum="1" TickFrequency=".05"
                          SmallChange=".05" LargeChange=".10" IsSnapToTickEnabled="True" ValueChanged="ButtonEffect_SliderChanged"
                          AutomationProperties.Name="Hover bounce intensity" Margin="0,0,0,8"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsChecked, ElementName=ButtonRingBox, Converter={StaticResource Bool}}">
                  <DockPanel Margin="0,4,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=ButtonRingIntensityBox, StringFormat=P0}" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="Ring intensity" Style="{StaticResource Label}" Margin="0"/>
                  </DockPanel>
                  <Slider x:Name="ButtonRingIntensityBox" Style="{StaticResource BackgroundSlider}" Minimum=".1" Maximum="1" TickFrequency=".05"
                          SmallChange=".05" LargeChange=".10" IsSnapToTickEnabled="True" ValueChanged="ButtonEffect_SliderChanged"
                          AutomationProperties.Name="Accent ring intensity" Margin="0,0,0,8"/>
                </StackPanel>
                <Border Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="{DynamicResource PanelCorner}" Padding="12,10" Margin="0,4,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="ButtonPreviewPrimary" Content="Highlight" Style="{StaticResource Primary}" Margin="0,0,10,0"/>
                    <Button x:Name="ButtonPreviewNav" Style="{StaticResource NavIcon}" Background="{DynamicResource NavSelected}" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" local:ButtonEffects.IsHighlight="True" local:TargetAura.Role="Module" AutomationProperties.Name="Preview nav highlight">
                      <local:Glyph Data="{DynamicResource IconChat}" Size="19"/>
                    </Button>
                    <Button x:Name="ButtonPreviewSend" Style="{StaticResource SendIcon}" Margin="0,0,10,0" AutomationProperties.Name="Preview send highlight">
                      <local:Glyph Data="{DynamicResource IconSend}" Size="19" StrokeThickness="2.2"/>
                    </Button>
                    <Button Content="Action" Style="{StaticResource Secondary}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="AppearanceCustomizeSection" Visibility="Collapsed">
                <TextBlock Text="Fonts" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Message font" Style="{StaticResource Label}"/><ComboBox x:Name="FontBox" MaxDropDownHeight="260" SelectionChanged="Font_Changed" AutomationProperties.Name="Message font"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Size" Style="{StaticResource Label}"/><ComboBox x:Name="SizeBox" SelectionChanged="Font_Changed" AutomationProperties.Name="Message text size"><ComboBoxItem Content="Small" Tag="small"/><ComboBoxItem Content="Medium" Tag="medium"/><ComboBoxItem Content="Large" Tag="large"/></ComboBox></StackPanel>
                </Grid>
                <Border Background="{DynamicResource Surface}" CornerRadius="{DynamicResource ComposerCorner}" Padding="14,10" Margin="0,12,0,18" HorizontalAlignment="Left">
                  <TextBlock x:Name="FontPreview" Text="The quick brown fox jumps over the lazy dog." TextWrapping="Wrap"/>
                </Border>
                <Separator Margin="0,0,0,14" Background="{DynamicResource Line}"/>
                <TextBlock Text="Background" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                  <Button Content="Choose image" Style="{StaticResource Secondary}" Click="ChooseBackground_Click"/>
                  <Button x:Name="RemoveBackgroundButton" Content="Remove" Style="{StaticResource Secondary}" Margin="8,0,0,0" Click="RemoveBackground_Click"/>
                </StackPanel>
                <StackPanel x:Name="BackgroundAdjustments" Visibility="Collapsed">
                  <Grid Margin="0,0,0,6">
                    <TextBlock Text="Image opacity" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding Value, ElementName=BackgroundOpacityBox, StringFormat=P0}" HorizontalAlignment="Right" Style="{StaticResource Label}"/>
                  </Grid>
                  <Slider x:Name="BackgroundOpacityBox" Style="{StaticResource BackgroundSlider}" Minimum=".10" Maximum=".55" TickFrequency=".05"
                          SmallChange=".05" LargeChange=".10" IsSnapToTickEnabled="True" AutomationProperties.Name="Background image opacity" Margin="0,0,0,14"/>
                  <Border Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                          CornerRadius="{DynamicResource PanelCorner}" Height="142" ClipToBounds="True">
                    <Image x:Name="BackgroundPreview" Stretch="UniformToFill" Opacity="{Binding Value, ElementName=BackgroundOpacityBox}"
                           AutomationProperties.Name="Chat background preview"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="BackgroundError" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="AboutPage" Style="{StaticResource Page}">
              <TextBlock Text="About" Style="{StaticResource Heading}"/>
              <Image Source="{DynamicResource BrandMark}" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,12"/>
              <TextBlock Text="Cyd Lan Messenger" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="VersionText" Margin="0,6,0,16"/>
              <TextBlock Text="Developer" Style="{StaticResource Label}"/>
              <TextBlock Text="MonsterHammer" Margin="0,0,0,12"/>
              <TextBlock Text="GPL-3.0-or-later" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <Button Content="Cancel" Style="{StaticResource Secondary}" Click="Cancel_Click" Margin="0,0,8,0"/>
          <Button Content="Save" AutomationProperties.Name="Save" Style="{StaticResource Primary}" Click="Save_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
