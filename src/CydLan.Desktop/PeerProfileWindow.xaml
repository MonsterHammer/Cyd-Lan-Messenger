<Window x:Class="CydLan.Desktop.PeerProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:CydLan.Desktop"
        Style="{StaticResource {x:Type Window}}" Title="Profile" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Bool"/>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Canvas}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Background="Transparent" Margin="18,0,10,0">
        <TextBlock Text="Profile" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
        <Button Style="{StaticResource Icon}" Width="30" Height="30" HorizontalAlignment="Right" ToolTip="Close" Click="Close_Click" AutomationProperties.Name="Close profile"><local:Glyph Data="{DynamicResource IconClose}" Size="15"/></Button>
      </Grid>
      <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,4,20,20">
          <!-- Expanded Avatar + Identity -->
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  CornerRadius="{DynamicResource OverlayCorner}" Padding="18,16">
            <StackPanel HorizontalAlignment="Center">
              <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Border CornerRadius="48" Background="{DynamicResource Avatar}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5">
                  <TextBlock x:Name="AvatarInitialsText" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Image x:Name="AvatarPhoto" Stretch="UniformToFill" local:Rounded.Radius="48" AutomationProperties.Name="Expanded profile picture"/>
                <Ellipse x:Name="PresenceDot" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                         Stroke="{DynamicResource Surface}" StrokeThickness="2.5"/>
              </Grid>
              <TextBlock x:Name="DisplayNameText" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock x:Name="FullNameText" FontSize="13" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,3,0,0" TextWrapping="Wrap"/>
              <Border x:Name="PresencePill" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="10,3" CornerRadius="10"
                      Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <TextBlock x:Name="PresenceText" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
              </Border>
            </StackPanel>
          </Border>

          <!-- Bio / About (shown when present) -->
          <StackPanel x:Name="BioSection" Margin="0,14,0,0">
            <TextBlock Text="Bio" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="2,0,0,6"/>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="{DynamicResource PanelCorner}" Padding="13,10">
              <TextBlock x:Name="BioText" FontSize="13" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>

          <!-- Companion created by this CydLan peer (hidden for legacy LAN peers) -->
          <StackPanel x:Name="CompanionSection" Margin="0,14,0,0" Visibility="Collapsed">
            <DockPanel Margin="2,0,0,6">
              <Button x:Name="UseCompanionButton" DockPanel.Dock="Right" Content="Use companion" Style="{StaticResource Secondary}"
                      Padding="10,4" FontSize="11.5" Click="UseCompanion_Click" AutomationProperties.Name="Use peer companion"/>
              <Button x:Name="BattleButton" DockPanel.Dock="Right" Content="Battle" Style="{StaticResource Primary}" Margin="0,0,6,0"
                      Padding="12,4" FontSize="11.5" Click="Battle_Click" AutomationProperties.Name="Battle this companion" Visibility="Collapsed"/>
              <TextBlock Text="Companion" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
            <Border x:Name="CompanionStage" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="{DynamicResource PanelCorner}" Height="138" ClipToBounds="True" Cursor="Hand"
                    MouseLeftButtonDown="CompanionStage_Click" MouseEnter="CompanionStage_MouseEnter" MouseLeave="CompanionStage_MouseLeave">
              <Grid>
                <Border Background="{DynamicResource ChatColorFinishBrush}" IsHitTestVisible="False"/>
                <local:FloatingPetVisual x:Name="PeerPetVisual" Width="160" Height="124" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                         RenderTransformOrigin="0.5,0.92">
                  <local:FloatingPetVisual.RenderTransform>
                    <ScaleTransform ScaleX="1.22" ScaleY="1.22"/>
                  </local:FloatingPetVisual.RenderTransform>
                </local:FloatingPetVisual>
              </Grid>
            </Border>
          </StackPanel>

          <!-- Available technical details -->
          <Grid x:Name="DetailsGrid" Margin="2,14,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="AddressGroup">
              <TextBlock Text="Device address" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
              <TextBlock x:Name="AddressText" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel x:Name="ClientGroup" Grid.Column="2">
              <TextBlock Text="Client" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
              <TextBlock x:Name="ClientText" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
